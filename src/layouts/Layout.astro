---
/**
 * 基础布局
 *  - 全局样式（色板 / 字体 / 8px 网格 / 断点）
 *  - 响应式导航 + 页脚
 *  - 页面转场（Astro ClientRouter）与共享客户端行为
 *  - SEO / OG 元信息
 */
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
import { assetUrl } from "../lib/assets";
import "../styles/global.css";

/*
  首屏字体预载：Barlow 900（全站大标题）与 Tektur（编号/标签）在五页首屏都会用到，
  提前发起请求可消除 font-display:swap 造成的 FOUT。
  只预载这两个 —— Barlow 400/600 是正文用字，并非每页首屏都需要，预载会浪费带宽。
  走 `?url` 导入让 Vite 解析出与 global.css 中 url() 完全相同的指纹文件名，
  因此预载地址与 CSS 实际请求的地址一致，浏览器会复用而非重复下载。
*/
import barlow900Url from "../assets/fonts/barlow-900.woff2?url";
import tekturUrl from "../assets/fonts/tektur-var.woff2?url";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** 是否渲染底部播放器（默认开；剧情等纯阅读页可关） */
  player?: boolean;
}

const {
  title,
  description = "GIRLS BAND CRY（少女乐队哭泣）粉丝站 —— 角色、音乐、画廊与剧情资料整理，文案取自官方与萌娘百科。",
  ogImage = "assets/posters/01.webp",
  noindex = false,
  player = true,
} = Astro.props;

const SITE = "GIRLS BAND CRY";
const fullTitle = title ? `${title} | ${SITE}` : `${SITE} | 少女乐队哭泣 粉丝站`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "http://localhost:4321");
const ogImageUrl = new URL(assetUrl(ogImage), Astro.site ?? "http://localhost:4321");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical.href} />

    <link rel="icon" type="image/webp" href={assetUrl("assets/logo/brand/01-brand.webp")} />
    <meta name="theme-color" content="#0E0F13" />
    <meta name="color-scheme" content="dark" />

    <!-- 首屏字体预载（crossorigin 是字体预载的硬性要求：字体以 CORS 模式获取） -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={barlow900Url}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={tekturUrl}
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <ClientRouter />

    <!-- 无 JS / JS 失败时的兜底：[data-reveal] 由脚本触发入场，
         脚本没跑时必须让内容直接可见，否则整页正文永久隐藏。 -->
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>

  <body class:list={[player && "has-player"]}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {player && <MusicPlayer />}
    <Lightbox />

    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
