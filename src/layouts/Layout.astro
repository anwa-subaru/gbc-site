---
/**
 * 基础布局
 *  - 全局样式（色板 / 字体 / 8px 网格 / 断点）
 *  - 响应式导航 + 页脚
 *  - 页面转场（Astro ClientRouter）与共享客户端行为
 *  - SEO / OG 元信息
 */
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
import PlayerBar from "../components/PlayerBar.astro";
import { assetUrl } from "../lib/assets";
import { DICTS, STORAGE_KEY } from "../i18n";
import "../styles/global.css";

/*
  首屏字体预载：Barlow 900（全站大标题）与 Tektur（编号/标签）在五页首屏都会用到，
  提前发起请求可消除 font-display:swap 造成的 FOUT。
  只预载这两个 —— Barlow 400/600 是正文用字，并非每页首屏都需要，预载会浪费带宽。
  走 `?url` 导入让 Vite 解析出与 global.css 中 url() 完全相同的指纹文件名，
  因此预载地址与 CSS 实际请求的地址一致，浏览器会复用而非重复下载。
*/
import barlow900Url from "../assets/fonts/barlow-900.woff2?url";
import tekturUrl from "../assets/fonts/tektur-var.woff2?url";

interface Props {
  /** 词典 key：<title> 与 meta description 都从这里取，切语言时客户端会改写 */
  titleKey?: string;
  descKey?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  titleKey = "meta.title.home",
  descKey = "meta.desc.home",
  ogImage = "assets/posters/01.webp",
  noindex = false,
} = Astro.props;

const SITE = "GIRLS BAND CRY";
/* SSR 一律输出中文（本站主要面向中文用户，也是默认语言）：
   关掉 JS 或爬虫抓到的都是完整中文页面，切语言由 src/scripts/i18n.ts 在客户端做 */
const zh = DICTS.zh;
const fullTitle = zh[titleKey] ?? SITE;
const description = zh[descKey] ?? "";

const canonical = new URL(Astro.url.pathname, Astro.site ?? "http://localhost:4321");
const ogImageUrl = new URL(assetUrl(ogImage), Astro.site ?? "http://localhost:4321");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical.href} />

    <link rel="icon" type="image/webp" href={assetUrl("assets/logo/brand/01-brand.webp")} />
    <meta name="theme-color" content="#0E0F13" />
    <meta name="color-scheme" content="dark" />

    <!-- 首屏字体预载（crossorigin 是字体预载的硬性要求：字体以 CORS 模式获取） -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={barlow900Url}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={tekturUrl}
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <ClientRouter />

    <!--
      首屏语言：在绘制前把 localStorage 里的选择写到 <html> 上。
      必须是内联脚本——外链模块要等解析完才开始下载，那样非中文用户会先看到
      一整屏中文再被替换掉（明显闪一下）。astro:after-swap 让跨页导航同样不闪。
    -->
    <script is:inline>
      (function () {
        var K = "gbc.lang";
        var L = { zh: "zh-CN", en: "en", ja: "ja" };
        function sync() {
          try {
            var v = localStorage.getItem(K);
            if (v !== "zh" && v !== "en" && v !== "ja") v = "zh";
            document.documentElement.lang = L[v];
            document.documentElement.dataset.lang = v;
          } catch (e) {
            /* 隐私模式读不到，保持默认中文 */
          }
        }
        sync();
        document.addEventListener("astro:after-swap", sync);

        /* 懒加载图片淡入。要点：
           · html.js 在这里就地加上（首屏绘制之前），CSS 才敢把 opacity 归零；
             这段脚本万一没跑，图片就是普通显示，绝不会留白板。
           · load / error 都不冒泡，必须用捕获阶段监听；而且**只能挂 document**：
             实测 window 上的捕获收不到图片 load（0 次），document 能收到。
           · 8 秒兜底全显形：宁可没有淡入，也不要留一块永远空着的洞。 */
        document.documentElement.classList.add("js");
        if (!window.__gbcLazy) {
          window.__gbcLazy = 1;
          var mark = function (img) {
            if (img && img.classList) img.classList.add("is-loaded");
          };
          var sweep = function () {
            var imgs = document.querySelectorAll('img[loading="lazy"]');
            for (var i = 0; i < imgs.length; i++) {
              if (imgs[i].complete) mark(imgs[i]);
            }
          };
          document.addEventListener(
            "load",
            function (e) {
              var t = e.target;
              if (t && t.tagName === "IMG" && t.getAttribute("loading") === "lazy") mark(t);
            },
            true,
          );
          document.addEventListener(
            "error",
            function (e) {
              var t = e.target;
              if (t && t.tagName === "IMG") mark(t);
            },
            true,
          );
          document.addEventListener("DOMContentLoaded", sweep);
          document.addEventListener("astro:after-swap", sweep);
          document.addEventListener("astro:page-load", sweep);
          if (document.readyState !== "loading") sweep();
          setTimeout(sweep, 8000);
          setTimeout(function () {
            var imgs = document.querySelectorAll('img[loading="lazy"]');
            for (var i = 0; i < imgs.length; i++) mark(imgs[i]);
          }, 8000);
        }
      })();
    </script>

    <!-- 无 JS / JS 失败时的兜底：[data-reveal] 由脚本触发入场，
         脚本没跑时必须让内容直接可见，否则整页正文永久隐藏。 -->
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>

  <body data-i18n-title={titleKey} data-i18n-desc={descKey}>
    <a class="skip-link" href="#main" data-i18n="layout.skip">跳到主要内容</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/* 全局播放条：固定在底部，transition:persist 让它在页面切换时不被替换，
        音乐可以跨页继续放 */}
    <PlayerBar />

    <Lightbox />

    <script>
      import "../scripts/site.ts";
      import "../scripts/i18n.ts";
    </script>
  </body>
</html>
