---
/**
 * 卡面动画预览页 `/preview`（未公开、noindex）
 * 用途：素材库里 14 支竖版视频还没决定要不要上站，先做一个能逐个播放的页面，
 * 由站主自己看完再挑编号。挑中的编号会汇总在底部，截图发回即可。
 */
import Layout from "../layouts/Layout.astro";
import { assetUrl } from "../lib/assets";
import items from "../data/card-anime.json";

const total = items.reduce((s, v) => s + v.mb, 0);
const totalSec = items.reduce((s, v) => s + v.dur, 0);
---

<Layout
  title="卡面动画 · 预览"
  description="站内预览：素材库中 14 支竖版卡面动画，逐支试看并勾选是否收录。"
  noindex
>
  <section class="ca">
    <header class="ca__head" data-reveal>
      <p class="label ca__eyebrow">PREVIEW · 未公开页面</p>
      <h1 class="ca__title">卡面动画 <span class="num">{items.length}</span> 支</h1>
      <p class="ca__lead">
        素材库里这 14 支竖版视频（1080×1618，5–61 秒，共 {total.toFixed(0)}MB，
        合计 {Math.round(totalSec)} 秒），我判断是手游《ガールズバンドクライ
        First Riff》的卡面演出动画 —— 都是竖屏、带音轨、单场景。站上目前一支都没用。
      </p>
      <p class="ca__lead ca__lead--sub">
        往下逐个点开看（同一时间只会播一支）。觉得该收录就按「要这个」，
        页面底部会汇总编号，<strong>截图发我</strong>即可，也可以直接报编号。
      </p>
    </header>

    <div class="ca__grid">
      {
        items.map((v) => (
          <figure class="ca__item" data-reveal>
            <div class="ca__frame">
              <video
                class="ca__video"
                src={assetUrl(`assets/videos/card-anime/${v.file}.mp4`)}
                poster={assetUrl(`assets/videos/card-anime/${v.file}.jpg`)}
                preload="none"
                playsinline
                width={v.w}
                height={v.h}
                data-ca-video
              />
              <button
                class="ca__tap"
                type="button"
                data-ca-play
                aria-label={`播放 ${v.name}`}
              >
                <span class="ca__tri" aria-hidden="true" />
              </button>
              <span class="ca__id label">{v.id}</span>
            </div>
            <figcaption class="ca__cap">
              <p class="ca__name">{v.name}</p>
              <p class="ca__sub num">
                {v.dur}s · {v.mb}MB
              </p>
              <button class="ca__pick" type="button" data-ca-pick data-id={v.id}>
                <span class="ca__box" aria-hidden="true" />
                <span data-ca-pick-text>要这个</span>
              </button>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="ca__bar" data-ca-bar hidden>
      <p class="ca__bar-text">
        已选 <span class="num" data-ca-count>0</span> 支：
        <span class="ca__bar-ids num" data-ca-ids>—</span>
      </p>
      <p class="ca__bar-hint">截图发我，或直接报这些编号</p>
    </div>

    <p class="ca__foot">
      对比参考：音乐页已经用了 5 支官方 4K 角色 PV（横版、带 controls）——
      <a href="/music/">/music/</a> 页面底部。
    </p>
  </section>
</Layout>

<style>
  .ca {
    padding: var(--sp-6) var(--container-pad) calc(var(--sp-8) + 80px);
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .ca__eyebrow {
    color: var(--gbc-red);
  }

  .ca__title {
    margin-top: var(--sp-2);
    font-size: var(--fs-h2);
    font-weight: var(--fw-black);
  }

  .ca__lead {
    margin-top: var(--sp-3);
    max-width: 60ch;
    color: var(--ink-100);
    font-size: var(--fs-sm);
  }

  .ca__lead--sub {
    color: var(--fg-muted);
  }

  .ca__lead strong {
    color: var(--ink-000);
  }

  .ca__grid {
    margin-top: var(--sp-5);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--sp-3);
  }

  @media (min-width: 768px) {
    .ca__grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--sp-4);
    }
  }

  .ca__item {
    min-width: 0;
  }

  .ca__frame {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--ink-950);
    border: 1px solid var(--border);
    transition: border-color var(--dur-base) var(--ease-out-cubic);
  }

  .ca__item:has(.ca__pick[aria-pressed="true"]) .ca__frame {
    border-color: var(--gbc-red);
  }

  .ca__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ca__tap {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.15), rgb(0 0 0 / 0.45));
    cursor: pointer;
  }

  .ca__tap[hidden] {
    display: none;
  }

  .ca__tri {
    width: 0;
    height: 0;
    border-left: 16px solid var(--ink-000);
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    filter: drop-shadow(0 2px 8px rgb(0 0 0 / 0.6));
    transition: transform var(--dur-base) var(--ease-out-cubic);
  }

  .ca__tap:hover .ca__tri {
    transform: scale(1.15);
  }

  .ca__id {
    position: absolute;
    top: var(--sp-2);
    left: var(--sp-2);
    padding: 2px 6px;
    background: var(--gbc-red);
    color: var(--ink-000);
    font-weight: var(--fw-bold);
    letter-spacing: 0.04em;
  }

  .ca__cap {
    padding-top: var(--sp-2);
  }

  .ca__name {
    font-weight: var(--fw-bold);
    font-size: var(--fs-sm);
    line-height: 1.4;
  }

  .ca__sub {
    color: var(--fg-muted);
    font-size: var(--fs-xs);
  }

  .ca__pick {
    margin-top: var(--sp-2);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border: 1px solid var(--border);
    background: none;
    color: var(--fg-muted);
    font: inherit;
    font-size: var(--fs-xs);
    cursor: pointer;
    transition:
      color var(--dur-base) var(--ease-out-cubic),
      border-color var(--dur-base) var(--ease-out-cubic);
  }

  .ca__box {
    width: 11px;
    height: 11px;
    border: 1px solid currentColor;
  }

  .ca__pick[aria-pressed="true"] {
    color: var(--gbc-red);
    border-color: var(--gbc-red);
  }

  .ca__pick[aria-pressed="true"] .ca__box {
    background: var(--gbc-red);
  }

  .ca__bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    padding: var(--sp-3) var(--container-pad)
      calc(var(--sp-3) + env(safe-area-inset-bottom, 0px));
    background: var(--ink-950);
    border-top: 1px solid var(--gbc-red);
  }

  .ca__bar[hidden] {
    display: none;
  }

  .ca__bar-text {
    font-size: var(--fs-sm);
  }

  .ca__bar-ids {
    color: var(--gbc-red);
    font-weight: var(--fw-bold);
  }

  .ca__bar-hint {
    color: var(--fg-muted);
    font-size: var(--fs-xs);
  }

  .ca__foot {
    margin-top: var(--sp-5);
    color: var(--fg-muted);
    font-size: var(--fs-xs);
  }

  .ca__foot a {
    color: var(--neon-cyan);
  }
</style>

<script>
  const videos = Array.from(
    document.querySelectorAll<HTMLVideoElement>("[data-ca-video]"),
  );

  /* 一次只播一支：竖版视频声音都不小，同时播会糊在一起 */
  document.addEventListener("click", (e) => {
    const tap = (e.target as HTMLElement | null)?.closest?.(
      "[data-ca-play]",
    ) as HTMLElement | null;
    if (tap) {
      const video = tap.parentElement?.querySelector<HTMLVideoElement>(
        "[data-ca-video]",
      );
      if (!video) return;
      videos.forEach((v) => {
        if (v !== video && !v.paused) v.pause();
      });
      video.controls = true;
      tap.hidden = true;
      void video.play();
      return;
    }
  });

  /* 播完把播放按钮放回来，方便再看一遍 */
  videos.forEach((v) => {
    v.addEventListener("ended", () => {
      const tap = v.parentElement?.querySelector<HTMLElement>("[data-ca-play]");
      if (tap) tap.hidden = false;
      v.controls = false;
    });
  });

  /* 勾选汇总 */
  const bar = document.querySelector<HTMLElement>("[data-ca-bar]");
  const countEl = document.querySelector<HTMLElement>("[data-ca-count]");
  const idsEl = document.querySelector<HTMLElement>("[data-ca-ids]");
  const picks = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-ca-pick]"),
  );

  const paint = (): void => {
    const ids = picks
      .filter((b) => b.getAttribute("aria-pressed") === "true")
      .map((b) => b.dataset.id ?? "");
    if (countEl) countEl.textContent = String(ids.length);
    if (idsEl) idsEl.textContent = ids.length ? ids.join(" · ") : "—";
    if (bar) bar.hidden = ids.length === 0;
  };

  picks.forEach((btn) => {
    btn.addEventListener("click", () => {
      const on = btn.getAttribute("aria-pressed") === "true";
      btn.setAttribute("aria-pressed", on ? "false" : "true");
      const text = btn.querySelector("[data-ca-pick-text]");
      if (text) text.textContent = on ? "要这个" : "已选";
      paint();
    });
  });
</script>
