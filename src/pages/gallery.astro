---
/**
 * 画廊页 `/gallery`（t5e）
 * 版式取自 DESIGN.md §7.4：CSS columns 瀑布流（桌面 3 列 / 移动 1 列），
 * 点按 → 全屏灯箱（Layout 里的全局单例，Esc 关闭 / ←→ 切换 / 焦点锁定）。
 * 素材全部经 src/lib/assets.ts 的 assetUrl() 拼 BASE_URL。
 */
import Layout from "../layouts/Layout.astro";
import { assetUrl, category, type AssetEntry } from "../lib/assets";
import customLabels from "../data/gallery-labels.json";

/* ---------- 分类：按来源分区（DESIGN.md §7.4「分组」） ---------- */
interface GroupDef {
  id: string;
  label: string;
  ja: string;
  note: string;
  /** 参与该组的子目录（空数组 = 该分类根目录） */
  subs: string[];
  /** 每个子目录最多取几张（0 = 不限） */
  cap: number;
  /** 素材来源分类，默认 artworks（海报组取 posters） */
  from?: "artworks" | "posters" | "emoji";
}

const GROUPS: GroupDef[] = [
  {
    id: "poster",
    label: "海报",
    ja: "宣伝ビジュアル",
    note: "宣发海报 / KV",
    subs: [],
    cap: 0,
    from: "posters",
  },
  {
    id: "art",
    label: "贺图",
    ja: "描き下ろし",
    note: "官方贺图与角色设定图",
    subs: [
      "anime",
      "nari-illust",
      "character-design",
      "movie",
      "solo",
      "cry-rose",
      "heisei-gyaru",
    ],
    cap: 0,
  },
  {
    id: "collect",
    label: "收藏集",
    ja: "グッズ",
    note: "周边、联动与收藏用视觉资料",
    subs: [
      "gacha-art",
      "jellyfish",
      "mini",
      "mv-unmei",
      "merch-promo",
      "popup-shop",
      "shimamura",
      "shimamura-kawasaki",
      "acrylic-plate",
      "acrylic-strap",
      "badges",
      "card-sleeve",
      "plush",
      "sanrio",
      "work-cat",
      "work-cat-2",
      "misc",
    ],
    /* 0 = 不限。原先每子目录只取 10 张，导致三丽鸥 130 张、卡池 30 张、
       水母周边 46 张等 400 多张素材根本进不了页面（用户提供的素材应当可见）。 */
    cap: 0,
  },
  {
    id: "sticker",
    label: "表情",
    ja: "スタンプ",
    note: "官方表情包（静图 / 动图）",
    subs: [],
    cap: 0,
    from: "emoji",
  },
];

const artworks = category("artworks");
const posters = category("posters");
/* 表情包：animated-1（静态 WebP 版）与 animated（GIF 版）是同一套 20 张贴纸，
   两套都放会在画廊里出现一模一样的重复项，只保留动图那一套。 */
const emojis = category("emoji").filter((e) => !e.path.includes("/emoji/animated-1/"));

const inRoot = (e: AssetEntry): boolean => e.path.split("/").length === 3;
const inSub = (e: AssetEntry, sub: string): boolean =>
  e.path.startsWith(`assets/artworks/${sub}/`);

function collect(g: GroupDef): AssetEntry[] {
  if (g.from === "emoji") return emojis;
  if (g.from === "posters" || g.subs.length === 0) return posters;
  if (g.cap === 0) {
    return g.subs.flatMap((s) => artworks.filter((e) => inSub(e, s)));
  }
  return g.subs.flatMap((s) => artworks.filter((e) => inSub(e, s)).slice(0, g.cap));
}

interface Item extends AssetEntry {
  group: string;
}

const ITEMS: Item[] = GROUPS.flatMap((g) =>
  collect(g).map((e) => ({ ...e, group: g.id })),
);

const countOf = (id: string): number => ITEMS.filter((i) => i.group === id).length;

/** 文件名去扩展名作为可读标签。 */
/* 显示名：优先用 src/data/gallery-labels.json 里人工核定的名称。
   原始素材名大量是 UUID、纯编号（101.webp）或时间戳，直接展示等于没有名字。
   兜底仍保留原文件名去扩展名、连字符转空格。 */
const LABELS = customLabels as Record<string, string>;
const labelOf = (e: AssetEntry): string =>
  LABELS[e.path] ?? e.source_name.replace(/\.[^.]+$/, "").replace(/[-_]+/g, " ");

const GROUPS_WITH_COUNT = GROUPS.map((g) => ({ ...g, count: countOf(g.id) }));
const TOTAL = ITEMS.length;
const EAGER = 6;
---

<Layout
  title="画廊"
  description="GIRLS BAND CRY 官方视觉资料：宣发海报、贺图与周边收藏集，点击可全屏放大浏览"
>
  <header class="gp-head container">
    <p class="gp-head__ja">ギャラリー</p>
    <h1 class="gp-head__en">GALLERY</h1>
    <p class="gp-head__lead">
      站内收录官方宣发海报、贺图与周边收藏集视觉资料，共
      <span class="num">{TOTAL}</span> 张
    </p>
  </header>

  <nav class="gp-tabs container" aria-label="画廊分类筛选" data-gal-filter>
    <button class="gp-tab is-on" type="button" data-gal-tab="all" aria-pressed="true">
      全部<span class="num">{TOTAL}</span>
    </button>
    {
      GROUPS_WITH_COUNT.map((g) => (
        <button class="gp-tab" type="button" data-gal-tab={g.id} aria-pressed="false">
          {g.label}
          <span class="num">{g.count}</span>
        </button>
      ))
    }
  </nav>

  <div class="container">
    <div class="gal gal--masonry" role="list" data-gallery>
      {
        ITEMS.map((e, i) => (
          <button
            class="gal__item"
            type="button"
            role="listitem"
            data-gal-item={e.group}
            data-lightbox-src={assetUrl(e.path)}
            data-lightbox-alt={labelOf(e)}
            data-lightbox-w={e.width ?? 0}
            data-lightbox-h={e.height ?? 0}
            data-lightbox-group={e.group}
            aria-label={`放大查看：${labelOf(e)}`}
          >
            <img
              class="gal__img"
              src={assetUrl(e.path)}
              alt={labelOf(e)}
              width={e.width}
              height={e.height}
              loading={i < EAGER ? "eager" : "lazy"}
              decoding="async"
            />
            <span class="gal__hover" aria-hidden="true">
              <span class="gal__label">{labelOf(e)}</span>
              <svg
                class="gal__zoom"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="11" cy="11" r="7" />
                <path d="M20 20l-3.5-3.5M11 8v6M8 11h6" />
              </svg>
            </span>
          </button>
        ))
      }
    </div>

    <p class="gp-empty" data-gal-empty hidden>该分类下暂无素材</p>
  </div>
</Layout>

<script>
  /* 分类筛选：仅切换 display，灯箱在点击时实时查询 DOM，
     因此被隐藏的项不会进入灯箱序列（site.ts 的 initLightbox 行为）。 */
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-gal-tab]");
  const items = document.querySelectorAll<HTMLElement>("[data-gal-item]");
  const empty = document.querySelector<HTMLElement>("[data-gal-empty]");

  function apply(group: string): void {
    let shown = 0;
    items.forEach((el) => {
      const on = group === "all" || el.dataset.galItem === group;
      el.hidden = !on;
      if (on) shown += 1;
    });
    tabs.forEach((t) => {
      const on = t.dataset.galTab === group;
      t.classList.toggle("is-on", on);
      t.setAttribute("aria-pressed", String(on));
    });
    if (empty) empty.hidden = shown > 0;
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => apply(tab.dataset.galTab ?? "all"));
  });
</script>

<style>
  .gp-head {
    padding-block: var(--sp-6) var(--sp-4);
  }

  .gp-head__ja {
    font-size: var(--fs-sm);
    letter-spacing: 0.24em;
    color: var(--gbc-red-text);
  }

  .gp-head__en {
    font-size: var(--fs-display);
    font-weight: var(--fw-black);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .gp-head__lead {
    max-width: 62ch;
    margin-top: var(--sp-4);
    color: var(--ink-300);
    font-size: var(--fs-sm);
    line-height: 1.9;
  }

  /* ---- 分类 Tab：移动端横向滚动，桌面直接排开 ---- */
  .gp-tabs {
    display: flex;
    gap: var(--sp-2);
    margin-bottom: var(--sp-5);
    padding-bottom: var(--sp-3);
    overflow-x: auto;
    border-bottom: 1px solid var(--border);
    scrollbar-width: none;
    /* 201 张图 ≈ 35 屏，筛选条必须吸顶，否则下滚后够不到。
       吸顶元素不能用 mask（会随滚动一起渐隐），故只在手机横滚时保留渐隐。
       偏移必须取 --nav-h（64/72 随断点变），写死数值会在另一断点漏出缝隙。 */
    position: sticky;
    top: var(--nav-h);
    z-index: 5;
    background: var(--ink-950);
    -webkit-mask-image: none;
    mask-image: none;
  }

  @media (max-width: 767px) {
    .gp-tabs {
      -webkit-mask-image: linear-gradient(
        to right,
        #000 0,
        #000 calc(100% - 28px),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        #000 0,
        #000 calc(100% - 28px),
        transparent 100%
      );
    }
  }

  .gp-tabs::-webkit-scrollbar {
    display: none;
  }

  .gp-tab {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    min-height: 44px; /* 移动端触控目标下限 */
    padding: var(--sp-2) var(--sp-4);
    background: transparent;
    border: 1px solid var(--border);
    color: var(--ink-300);
    font-size: var(--fs-sm);
    letter-spacing: 0.06em;
    cursor: pointer;
    transition:
      border-color var(--dur-base) var(--ease-out-cubic),
      color var(--dur-base) var(--ease-out-cubic);
  }

  .gp-tab .num {
    font-size: var(--fs-xs);
    color: var(--ink-300);
  }

  .gp-tab:hover {
    border-color: var(--ink-300);
    color: var(--ink-100);
  }

  .gp-tab.is-on {
    border-color: var(--gbc-red);
    color: var(--ink-000);
  }

  .gp-tab.is-on .num {
    color: var(--gbc-red-text);
  }

  .gp-tab:focus-visible {
    outline: 2px solid var(--gbc-red);
    outline-offset: 2px;
  }

  /* ---- 瀑布流：DESIGN.md §7.4 —— 移动 2 列，桌面 3 列，24px 间距 ---- */
  .gal {
    column-gap: var(--sp-4);
  }

  .gal--masonry {
    /* 1 列时整页高达 8 万 px（≈103 屏）；手机端直接 2 列，页高砍到一半。 */
    columns: 2;
  }

  .gal--masonry .gal__item {
    display: block;
    /* [hidden] 的 UA 默认 display:none 会被上面 .gal--masonry .gal__item
       (0,1,1) 压过 → tab 筛选时 171 张隐藏图仍然显示(用户反馈"点了没切换")。
       用 !important 恢复隐藏语义。 */
    &[hidden] {
      display: none !important;
    }
    width: 100%;
    margin-bottom: var(--sp-4);
    break-inside: avoid;
  }

  .gal--masonry .gal__img {
    width: 100%;
    height: auto;
  }

  @media (min-width: 768px) {
    .gal--masonry {
      columns: 2;
    }
  }

  @media (min-width: 1024px) {
    .gal--masonry {
      columns: 3;
    }
  }

  /* 1440 等大屏仍 3 列会把 201 张图拉到 3 万 px；≥1280 加第 4 列。 */
  @media (min-width: 1280px) {
    .gal--masonry {
      columns: 4;
    }
  }

  /* 超宽屏再加第 5 列，避免单图被拉得过大。 */
  @media (min-width: 1600px) {
    .gal--masonry {
      columns: 5;
    }
  }

  .gal__item[hidden] {
    display: none !important;
  }

  /* ---- 卡片与悬停浮层（与 components/Gallery.astro 同一套视觉） ---- */
  .gal__item {
    position: relative;
    display: block;
    padding: 0;
    overflow: hidden;
    background: var(--ink-850);
    border: 1px solid var(--border);
    cursor: zoom-in;
    transition: border-color var(--dur-base) var(--ease-out-cubic);
  }

  .gal__item:hover {
    border-color: var(--gbc-red);
  }

  .gal__img {
    display: block;
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }

  .gal__hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-2);
    padding: var(--sp-3);
    background: linear-gradient(
      to top,
      rgba(8, 9, 11, 0.92) 0%,
      rgba(8, 9, 11, 0.4) 45%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out-cubic);
  }

  .gal__label {
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--ink-000);
    text-align: left;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gal__zoom {
    flex: 0 0 auto;
    color: var(--neon-cyan);
  }

  @media (hover: hover) and (pointer: fine) {
    .gal__item:hover .gal__hover,
    .gal__item:focus-visible .gal__hover {
      opacity: 1;
    }

    .gal__item:hover .gal__img {
      transform: scale(1.05);
    }
  }

  .gp-empty {
    padding-block: var(--sp-6);
    text-align: center;
    color: var(--ink-300);
    font-size: var(--fs-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .gp-tab {
      transition: none;
    }

    .gal__img,
    .gal__hover {
      transition: none;
    }

    .gal__item:hover .gal__img {
      transform: none;
    }
  }
</style>
