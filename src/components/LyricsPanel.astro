---
/**
 * 歌词面板
 *  - 挂在 PlayerBar 内（transition:persist 节点里），跨页不断歌也不断词
 *  - 由 player.ts 驱动：当前句高亮居中、随进度滚动、点击任意句 seek
 *  - 数据源 src/data/lyrics/*.json（构建期内联，见 PlayerBar.astro）
 *  - 字体用自托管的 Noto Sans JP 子集（官方动画站同款，1118 字符）
 */
interface LyricLine {
  t: string;
}

interface LyricDoc {
  n: number;
  title: string;
  artist: string;
  lyricist: string;
  composer: string;
  use?: string;
  lines: string[];
}
---

<dialog class="lyr" data-lyrics aria-label="歌词">
  <div class="lyr__panel" role="document">
    <header class="lyr__head">
      <div class="lyr__meta">
        <p class="lyr__title" data-lyr-title>—</p>
        <p class="lyr__sub num" data-lyr-sub>—</p>
      </div>
      <button class="lyr__close" type="button" data-lyr-close aria-label="关闭歌词" title="关闭歌词">
        <svg viewBox="0 0 20 20" aria-hidden="true" width="18" height="18">
          <path
            d="M5 5l10 10M15 5L5 15"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </header>

    <div class="lyr__body" data-lyr-body>
      <ol class="lyr__lines" data-lyr-lines></ol>
      <p class="lyr__empty" data-lyr-empty hidden>この曲の歌詞は未収録です</p>
    </div>

    <footer class="lyr__cred">
      <p class="lyr__credline" data-lyr-cred>—</p>
    </footer>
  </div>
</dialog>

<style is:global>
  .lyr {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: none;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    max-width: 100%;
    max-height: 100%;
    background: rgb(6 7 10 / 0.8);
    backdrop-filter: blur(14px) saturate(0.6);
    overscroll-behavior: contain;
  }

  /* 打开：手机从底部升起的半屏 sheet */
  .lyr[open] {
    display: flex;
    animation: lyr-in 420ms cubic-bezier(0.34, 1.28, 0.64, 1);
  }

  .lyr::backdrop {
    background: rgb(6 7 10 / 0.8);
  }

  @keyframes lyr-in {
    from {
      opacity: 0;
    }
  }

  .lyr__panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: min(72vh, 640px);
    max-width: 720px;
    margin: 0;
    padding: var(--sp-4) 16px 0;
    background: color-mix(in srgb, var(--ink-850) 97%, transparent);
    border: 1px solid var(--border);
    border-bottom: 0;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    box-shadow: 0 -20px 60px rgb(0 0 0 / 0.6);
    animation: lyr-up 420ms cubic-bezier(0.34, 1.28, 0.64, 1);
  }

  @keyframes lyr-up {
    from {
      transform: translateY(28%);
      opacity: 0.6;
    }
  }

  .lyr__head {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--border);
  }

  .lyr__meta {
    min-width: 0;
    flex: 1;
  }

  .lyr__title {
    margin: 0;
    font-size: 18px;
    font-weight: var(--fw-black, 900);
    font-family: var(--font-lyric);
    line-height: 1.3;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lyr__sub {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin: 4px 0 0;
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    color: var(--fg-muted);
    overflow: hidden;
    white-space: nowrap;
  }

  /* 分隔用细竖线（全角｜在 mono 栈里走 fallback，换成伪元素） */
  .lyr__sub .lyr__sep {
    flex: 0 0 auto;
    width: 1px;
    height: 10px;
    background: currentColor;
    opacity: 0.5;
  }

  .lyr__sub > span,
  .lyr__sub > .num {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lyr__close {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: calc(var(--sp-2) * -1) calc(var(--sp-2) * -1) 0 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--ink-300);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out-cubic);
  }

  .lyr__close:hover {
    color: var(--fg);
  }

  .lyr__body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    /* 上下渐隐：歌词像从雾里走出来 */
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 9%,
      #000 82%,
      transparent 100%
    );
    scrollbar-width: none;
    overscroll-behavior: contain;
  }

  .lyr__body::-webkit-scrollbar {
    display: none;
  }

  .lyr__lines {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    margin: 0;
    padding: var(--sp-6) 0 var(--sp-6);
    list-style: none;
    text-align: center;
    justify-content: flex-start;
    transition: transform 320ms var(--ease-out-cubic);
    will-change: transform;
  }

  .lyr__line {
    padding: 0;
    font-size: var(--fs-md, 1.0625rem);
    font-weight: 500;
    font-family: var(--font-lyric);
    line-height: 1.9;
    letter-spacing: 0.02em;
    color: var(--ink-500, #6b7280);
    background: none;
    border: 0;
    cursor: pointer;
    transition:
      color var(--dur-base) var(--ease-out-cubic),
      opacity var(--dur-base) var(--ease-out-cubic),
      transform 320ms var(--ease-out-cubic);
  }

  /* 距离当前句越远越淡：JS 按行距写 --d（0=当前，1=远），
     亮度 = 亮灰 → 深灰 线性插值，远处落在渐隐 mask 里自然消失 */
  .lyr__line {
    color: color-mix(in srgb, var(--ink-300) calc((1 - var(--d, 1)) * 78%), var(--ink-850, #0a0b10));
  }

  .lyr__line:hover {
    color: var(--ink-200);
  }

  .lyr__line.is-cur {
    margin: var(--sp-2) 0;
    font-size: calc(var(--fs-md, 1.0625rem) * 1.28);
    font-weight: 900;
    color: var(--accent);
    letter-spacing: 0;
    text-wrap: balance;
    text-shadow: 0 0 10px rgb(244 0 0 / 0.42);
  }

  .lyr__empty {
    margin: var(--sp-8) 0;
    text-align: center;
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }

  .lyr__cred {
    flex: 0 0 auto;
    padding: var(--sp-3) 0;
    border-top: 1px solid var(--border);
  }

  .lyr__credline {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--ink-400);
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* 电脑：右侧竖卡而不是半屏 sheet，不遮正文 */
  @media (min-width: 1024px) {
    .lyr {
      align-items: flex-end;
      justify-content: flex-end;
    }

    .lyr__panel {
      width: min(480px, 40vw);
      height: min(78vh, 760px);
      /* 右侧贴角 32px；底部留 96px 正好避开 73px 高的播放条 */
      margin: 0 var(--sp-5) var(--sp-8) 0;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      border-bottom: 1px solid var(--border);
    }

    @keyframes lyr-up {
      from {
        transform: translateY(10%) scale(0.98);
        opacity: 0.5;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lyr[open],
    .lyr__panel,
    .lyr__lines,
    .lyr__line {
      animation: none;
      transition-duration: 1ms;
    }
  }
</style>
