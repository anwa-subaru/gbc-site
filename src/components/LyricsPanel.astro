---
/**
 * 全屏歌词
 *  - 入口：点播放条上的封面/曲名区（手机与电脑一致）
 *  - 挂在 PlayerBar 内（transition:persist 节点里），跨页不断歌也不断词
 *  - 由 player.ts 驱动：当前句高亮居中、随进度滚动、点击任意句 seek
 *  - 自带进度条与上一首/播放/下一首，全屏后仍能完整操作
 *  - 数据源 src/data/lyrics/*.json（构建期内联，见 PlayerBar.astro）
 *  - 字体用自托管的 Noto Sans JP 子集（官方动画站同款，1118 字符）
 */
---

<dialog class="lyr" data-lyrics data-i18n-attr="aria-label:lyrics.aria.dialog" aria-label="歌词">
  <div class="lyr__bg" aria-hidden="true">
    <img class="lyr__cover" alt="" data-lyr-cover />
    <span class="lyr__scrim"></span>
  </div>

  <div class="lyr__panel">
    <header class="lyr__head">
      <button
        class="lyr__down"
        type="button"
        data-lyr-close
        data-i18n-attr="aria-label:lyrics.close,title:lyrics.close"
        aria-label="收起歌词"
        title="收起歌词"
      >
        <svg viewBox="0 0 20 20" aria-hidden="true" width="20" height="20">
          <path
            d="M4.6 7.4L10 12.6l5.4-5.2"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <div class="lyr__meta">
        <p class="lyr__title" data-lyr-title>未选择曲目</p>
        <p class="lyr__sub">
          <span data-lyr-artist>—</span>
          <i class="lyr__sep"></i>
          <span class="num" data-lyr-dur>0:00</span>
        </p>
      </div>
      <div
        class="lyr__lang"
        role="group"
        data-i18n-attr="aria-label:lyrics.lang.aria"
        aria-label="翻译语言"
      >
        <button
          class="lyr__langbtn"
          type="button"
          data-lyr-lang="off"
          data-i18n-attr="title:lyrics.lang.off"
          title="只显示日文原文">日</button>
        <button
          class="lyr__langbtn is-on"
          type="button"
          data-lyr-lang="zh"
          data-i18n-attr="title:lyrics.lang.zh"
          title="日文原文 + 中文翻译">中</button>
        <button
          class="lyr__langbtn"
          type="button"
          data-lyr-lang="en"
          data-i18n-attr="title:lyrics.lang.en"
          title="日文原文 + English">英</button>
      </div>
    </header>

    <p class="lyr__cred" data-lyr-cred></p>

    <div class="lyr__body" data-lyr-body>
      <ol class="lyr__lines" data-lyr-lines></ol>
      <!-- 原文是日文；SSR 兜底统一用中文（见 spec：无 JS 时显示中文默认语言）。
           data-i18n 放在内层 span 上：外层 <p> 的 hidden 由 player.ts 控制，
           若直接挂在外层，i18n 运行时会把 hidden 改回 false 而误显空状态 -->
      <p class="lyr__empty" data-lyr-empty hidden><span data-i18n="lyrics.empty">这首歌还没有收录歌词</span></p>
    </div>

    <footer class="lyr__foot">
      <div class="lyr__prog">
        <span class="num lyr__time" data-lyr-cur>0:00</span>
        <input
          class="lyr__range"
          type="range"
          min="0"
          max="1000"
          value="0"
          step="1"
          data-lyr-seek
          data-i18n-attr="aria-label:lyrics.aria.seek"
          aria-label="播放进度"
        />
        <span class="num lyr__time" data-lyr-total>0:00</span>
      </div>

      <div class="lyr__ctrl">
        <button
          class="lyr__ic"
          type="button"
          data-lyr-prev
          data-i18n-attr="aria-label:lyrics.prev"
          aria-label="上一首"
        >
          <svg viewBox="0 0 20 20" aria-hidden="true" width="20" height="20">
            <path d="M15 4v12L7 10zM5 4h1.6v12H5z" fill="currentColor"></path>
          </svg>
        </button>
        <button
          class="lyr__ic lyr__ic--main"
          type="button"
          data-lyr-toggle
          data-i18n-attr="aria-label:lyrics.play"
          aria-label="播放"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" width="26" height="26" data-lyr-icon-play>
            <path d="M7 4.5v15l13-7.5z" fill="currentColor"></path>
          </svg>
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            width="26"
            height="26"
            data-lyr-icon-pause
            class="is-off"
          >
            <path d="M7 4.5h3.4v15H7zM13.6 4.5H17v15h-3.4z" fill="currentColor"></path>
          </svg>
        </button>
        <button
          class="lyr__ic"
          type="button"
          data-lyr-next
          data-i18n-attr="aria-label:lyrics.next"
          aria-label="下一首"
        >
          <svg viewBox="0 0 20 20" aria-hidden="true" width="20" height="20">
            <path d="M5 4v12l8-6zM13.4 4H15v12h-1.6z" fill="currentColor"></path>
          </svg>
        </button>
      </div>

    </footer>
  </div>
</dialog>

<style is:global>
  .lyr {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: none;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    padding: 0;
    border: 0;
    background: var(--ink-950, #07080c);
    overscroll-behavior: contain;
  }

  .lyr[open] {
    display: block;
    animation: lyr-in 320ms var(--ease-out-cubic, cubic-bezier(0.33, 1, 0.68, 1));
  }

  @keyframes lyr-in {
    from {
      opacity: 0;
      transform: translateY(3%);
    }
  }

  .lyr::backdrop {
    background: var(--ink-950, #07080c);
  }

  /* 背景：模糊的封面 + 压暗遮罩，保留一点专辑的气味 */
  .lyr__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .lyr__cover {
    position: absolute;
    inset: -18%;
    width: 136%;
    height: 132%;
    object-fit: cover;
    /* 背景就是这张专辑的封面，要"一眼认出是哪张"：
       18px 模糊 + 0.9 遮罩会糊成一片灰，等于没有封面。
       现在 7px 保留构图与配色，靠下面那层遮罩保证歌词可读。 */
    opacity: 1;
    filter: blur(7px) saturate(1.18);
    object-position: center 38%;
    transform: scale(1.05);
  }

  .lyr__scrim {
    position: absolute;
    inset: 0;
    /* 歌词所在的中段压暗保证可读，四周留亮让封面透出来；
       再配合歌词自身的 text-shadow，就不用把封面压成黑底 */
    background:
      radial-gradient(122% 56% at 50% 47%, rgb(7 8 12 / 0.62) 0%, rgb(7 8 12 / 0.38) 58%, rgb(7 8 12 / 0.14) 100%),
      linear-gradient(to bottom, rgb(7 8 12 / 0.42), rgb(7 8 12 / 0.2) 26%, rgb(7 8 12 / 0.24) 74%, rgb(7 8 12 / 0.48));
  }

  /* 手机：封面做背景太花、压不住字，改深色渐变（桌面仍用专辑封面） */
  @media (max-width: 1023.98px) {
    .lyr__cover {
      display: none;
    }
    .lyr__scrim {
      /* 纯黑打底 + 歌词区一点点提亮，避免整块死黑，也给中段一点聚焦感 */
      background:
        radial-gradient(135% 44% at 50% 40%, #12141b 0%, #0a0b10 54%, #07080c 100%),
        linear-gradient(to bottom, #0a0b10, #07080c 34%, #07080c 76%, #050609);
    }
  }

  .lyr__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: calc(var(--sp-3) + env(safe-area-inset-top, 0px)) 16px
      calc(var(--sp-4) + env(safe-area-inset-bottom, 0px));
  }

  .lyr__head {
    flex: 0 0 auto;
    /* 三列 1fr auto 1fr：歌名在整屏正中，右侧语言切换不会把标题挤歪 */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--sp-2);
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding-bottom: var(--sp-3);
  }

  .lyr__down {
    justify-self: start;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: calc(var(--sp-2) * -1);
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--ink-300);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out-cubic);
  }

  .lyr__down:hover {
    color: var(--fg);
  }

  /* 语言切换：日（只原文）/ 中（原文+中文）/ 英（原文+英文） */
  .lyr__lang {
    justify-self: end;
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.07);
  }

  .lyr__langbtn {
    min-width: 32px;
    height: 28px;
    padding: 0 6px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-300);
    font-family: var(--font-lyric);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out-cubic),
      background-color var(--dur-fast) var(--ease-out-cubic);
  }

  .lyr__langbtn:hover {
    color: var(--fg);
  }

  .lyr__langbtn.is-on {
    background: var(--accent);
    color: #fff;
  }

  .lyr__meta {
    min-width: 0;
    text-align: center;
  }

  .lyr__title {
    margin: 0;
    font-size: 17px;
    font-weight: 900;
    font-family: var(--font-lyric);
    line-height: 1.3;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lyr__sub {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    margin: 3px 0 0;
    font-size: var(--fs-xs);
    color: var(--fg-muted);
    overflow: hidden;
    white-space: nowrap;
  }

  .lyr__sub > span {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 分隔用细竖线（全角｜在 mono 栈里走 fallback，换成伪元素） */
  .lyr__sep {
    flex: 0 0 auto;
    width: 1px;
    height: 10px;
    background: currentColor;
    opacity: 0.5;
  }

  .lyr__body {
    position: relative;
    flex: 1;
    min-height: 0;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    overflow-y: auto;
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 7%,
      #000 90%,
      transparent 100%
    );
    scrollbar-width: none;
    overscroll-behavior: contain;
  }

  .lyr__body::-webkit-scrollbar {
    display: none;
  }

  .lyr__lines {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    /* 34vh 起步：第一句也有足够余量被居中，
       否则开头 scrollTop 被钳在 0，当前句会比中段低 47px */
    padding: 34vh 0 30vh;
    list-style: none;
    text-align: center;
  }

  /* 歌词行。
     两条硬规则（都是踩坑换来的）：
     1) 不能用 display:grid —— 每个逐字 span 会变成独立网格项，变成"一个字一行"
     2) 字号绝不能加 transition —— 会让整列逐帧重排，换句时"卡一下"
     非当前句统一一种中灰，不做按距离的亮度渐变：
     渐变会让上下几行糊成一片，参考 QQ 音乐歌词页的读法更清爽。 */
  .lyr__line {
    /* 背景是专辑封面（不再是纯黑），给字加一层柔和阴影保证可读 */
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.55), 0 0 2px rgb(0 0 0 / 0.4);
    display: block;
    padding: 9px 0;
    font-size: 19px;
    font-weight: 500;
    font-family: var(--font-lyric);
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--ink-300);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color var(--dur-base) var(--ease-out-cubic);
  }

  .lyr__line:hover {
    color: var(--ink-200);
  }

  /* 当前句：整句白字，唱到哪个字哪个字变红。
     字号与其它行一致（不再放大）——忽大忽小反而难看，也省掉换句时的重排 */
  .lyr__line.is-cur {
    font-weight: 900;
    color: var(--ink-000, #fff);
    letter-spacing: 0;
  }

  .lyr__orig {
    display: block;
  }

  /* 切语言的过场：整列淡出→换语言→淡入（行高变化发生在透明期，看不见跳动） */
  .lyr__lines {
    transition:
      opacity 170ms var(--ease-out-cubic),
      transform 170ms var(--ease-out-cubic);
  }

  .lyr__lines.is-swap {
    opacity: 0;
    transform: translateY(6px);
  }

  .lyr__ch {
    transition: color 160ms linear;
  }

  .lyr__ch.is-on {
    color: var(--accent);
    text-shadow: 0 0 14px rgb(244 0 0 / 0.45);
  }

  /* 译文行：比原文小一档、暗一档，只在 .lyr[data-lang] 选中的语言下显示。
     两种语言的 span 都常驻 DOM，切语言只改一个属性，不重建列表
     （重建会丢掉滚动位置和当前句状态） */
  .lyr__tr {
    display: none;
    margin-top: 5px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: 0;
    color: rgb(154 161 174 / 0.62);
  }

  .lyr__line.is-cur .lyr__tr {
    color: var(--ink-300);
  }

  .lyr[data-lang="zh"] .lyr__tr--zh,
  .lyr[data-lang="en"] .lyr__tr--en {
    display: block;
  }

  .lyr__empty {
    margin: 26vh 0;
    text-align: center;
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }

  .lyr__foot {
    flex: 0 0 auto;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding-top: var(--sp-3);
  }

  .lyr__prog {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .lyr__time {
    flex: 0 0 auto;
    min-width: 40px;
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }

  .lyr__time:last-child {
    text-align: right;
  }

  /* 滑轨 3px、输入框 44px：全屏下拖动更从容 */
  .lyr__range {
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    height: 44px;
    margin: 0;
    appearance: none;
    background: none;
    cursor: pointer;
  }

  .lyr__range::-webkit-slider-runnable-track {
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(
      to right,
      var(--accent) 0%,
      var(--accent) var(--p, 0%),
      rgb(255 255 255 / 0.22) var(--p, 0%),
      rgb(255 255 255 / 0.22) 100%
    );
  }

  .lyr__range::-moz-range-track {
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(
      to right,
      var(--accent) 0%,
      var(--accent) var(--p, 0%),
      rgb(255 255 255 / 0.22) var(--p, 0%),
      rgb(255 255 255 / 0.22) 100%
    );
  }

  .lyr__range::-webkit-slider-thumb {
    appearance: none;
    width: 12px;
    height: 12px;
    margin-top: -4.5px;
    border-radius: 50%;
    background: var(--ink-000, #fff);
  }

  .lyr__range::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 0;
    border-radius: 50%;
    background: var(--ink-000, #fff);
  }

  .lyr__ctrl {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-5);
    padding: var(--sp-2) 0 var(--sp-1);
  }

  .lyr__ic {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--fg);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out-cubic),
      transform var(--dur-fast) var(--ease-out-cubic);
  }

  .lyr__ic:hover {
    color: var(--accent);
  }

  .lyr__ic:active {
    transform: scale(0.94);
  }

  .lyr__ic--main {
    width: 68px;
    height: 68px;
    background: var(--accent);
    color: var(--ink-000, #fff);
  }

  .lyr__ic--main:hover {
    background: var(--gbc-red-deep, #c60000);
    color: var(--ink-000, #fff);
  }

  .lyr__ic svg.is-off {
    display: none;
  }

  /* 作詞・作曲：放在歌词**上方**（用户要求），小字居中 */
  .lyr__cred {
    flex: 0 0 auto;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding-bottom: var(--sp-2);
    font-size: var(--fs-xs);
    /* 背景换成专辑封面后，署名压在亮色画面上也要读得清 */
    color: rgb(255 255 255 / 0.82);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.6), 0 0 2px rgb(0 0 0 / 0.45);
    text-align: center;
    letter-spacing: 0.04em;
    /* 长署名换行而不是静默截断 */
    white-space: normal;
    text-wrap: balance;
  }

  .lyr__cred:empty {
    display: none;
  }

  /* 电脑：内容收窄居中、字号再大一点 */
  @media (min-width: 1024px) {
    .lyr__panel {
      padding: var(--sp-4) var(--sp-6) var(--sp-4);
    }

    .lyr__head,
    .lyr__body,
    .lyr__foot {
      max-width: 720px;
    }

    .lyr__line {
      padding: 11px 0;
      font-size: 25px;
    }

    .lyr__tr {
      margin-top: 6px;
      font-size: 16px;
    }

    .lyr__title {
      font-size: 19px;
    }

    /* 桌面两个纯红会互抢焦点，主按钮压深一档，让红只属于当前句 */
    .lyr__ic--main {
      width: 60px;
      height: 60px;
      background: var(--gbc-red-deep, #c60000);
    }
  }

  /* 手机端背景是深色，歌词不需要那么重的描边阴影（放在最后才盖得住上面的规则） */
  @media (max-width: 1023.98px) {
    .lyr__line {
      text-shadow: 0 1px 6px rgb(0 0 0 / 0.45);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lyr[open],
    .lyr__line {
      animation: none;
      transition-duration: 1ms;
    }
  }
</style>
