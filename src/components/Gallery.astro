---
/**
 * 画廊栅格
 *  - 手机：单/双列瀑布流，点按 → 全屏灯箱
 *  - 桌面：悬停浮层（标题 + 缩放图标），点击 → 居中灯箱
 *  - 悬停效果仅在 (hover: hover) 设备生效，避免移动端「粘滞 hover」
 *  - 灯箱本体是 Layout 里的全局单例，这里只负责渲染触发器
 */
import { assetUrl, type AssetEntry } from "../lib/assets";

interface Props {
  entries: AssetEntry[];
  group?: string;
  variant?: "masonry" | "grid";
  limit?: number;
  columns?: 2 | 3 | 4;
}

const {
  entries,
  group = "default",
  variant = "masonry",
  limit,
  columns = 3,
} = Astro.props;

const items = limit ? entries.slice(0, limit) : entries;

const labelOf = (e: AssetEntry): string =>
  e.source_name.replace(/\.[^.]+$/, "");
---

<div
  class:list={["gal", `gal--${variant}`, `gal--c${columns}`]}
  role="list"
  data-gallery
>
  {
    items.map((e) => (
      <button
        class="gal__item"
        type="button"
        role="listitem"
        data-lightbox-src={assetUrl(e.path)}
        data-lightbox-alt={labelOf(e)}
        data-lightbox-w={e.width ?? 0}
        data-lightbox-h={e.height ?? 0}
        data-lightbox-group={group}
        aria-label={`放大查看：${labelOf(e)}`}
      >
        <img
          class="gal__img"
          src={assetUrl(e.path)}
          alt={labelOf(e)}
          width={e.width}
          height={e.height}
          loading="lazy"
          decoding="async"
        />
        <span class="gal__hover" aria-hidden="true">
          <span class="gal__label">{labelOf(e)}</span>
          <svg class="gal__zoom" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7" />
            <path d="M20 20l-3.5-3.5M11 8v6M8 11h6" />
          </svg>
        </span>
      </button>
    ))
  }
</div>

<style>
  .gal {
    --cols: 2;
    column-gap: var(--grid-gap);
  }

  @media (min-width: 768px) {
    .gal--c3,
    .gal--c4 {
      --cols: 2;
    }
  }

  @media (min-width: 1024px) {
    .gal--c3 {
      --cols: 3;
    }
    .gal--c4 {
      --cols: 4;
    }
  }

  /* ---- 瀑布流：保持原始宽高比，适合画廊 ---- */
  .gal--masonry {
    columns: var(--cols);
  }

  .gal--masonry .gal__item {
    display: block;
    width: 100%;
    margin-bottom: var(--grid-gap);
    break-inside: avoid;
  }

  .gal--masonry .gal__img {
    width: 100%;
    height: auto;
  }

  /* ---- 等高栅格：统一裁切，适合周边/海报墙 ---- */
  .gal--grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--grid-gap);
  }

  .gal--grid .gal__item {
    aspect-ratio: 4 / 5;
  }

  .gal--grid .gal__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gal__item {
    position: relative;
    display: block;
    /* 恢复 [hidden] 隐藏语义：display:block 会压过 UA 默认(画廊 tab 筛选 bug) */
    &[hidden] {
      display: none !important;
    }
    padding: 0;
    overflow: hidden;
    background: var(--ink-850);
    border: 1px solid var(--border);
    cursor: zoom-in;
    transition: border-color var(--dur-base) var(--ease-out-cubic);
  }

  .gal__item:hover {
    border-color: var(--gbc-red);
  }

  .gal__img {
    display: block;
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }

  /* ---- 悬停浮层（仅精确指针设备） ---- */
  .gal__hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-2);
    padding: var(--sp-3);
    background: linear-gradient(to top, rgba(8, 9, 11, 0.92) 0%, rgba(8, 9, 11, 0.4) 45%, transparent 100%);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out-cubic);
  }

  .gal__label {
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--ink-000);
    text-align: left;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gal__zoom {
    flex: 0 0 auto;
    color: var(--neon-cyan);
  }

  @media (hover: hover) and (pointer: fine) {
    .gal__item:hover .gal__hover,
    .gal__item:focus-visible .gal__hover {
      opacity: 1;
    }
    .gal__item:hover .gal__img {
      transform: scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gal__img,
    .gal__hover {
      transition: none;
    }
    .gal__item:hover .gal__img {
      transform: none;
    }
  }
</style>
