---
/**
 * Hero 角色轮播（杂志式：左文案 + 右立绘）
 *  - 5 名成员各一屏：角色立绘(完整 contain，不 cover 裁切) + 角色主题色 + 标语
 *  - 解决旧 cover 全屏的痛点：特写失焦、文字压脸、人物被裁只剩 1/3
 *  - 自动轮播 6s；悬停/聚焦/切后台暂停；← → 键盘可切；圆点为 button
 *  - prefers-reduced-motion：不自动轮播、不做位移动画
 */
import {
  assetUrl,
  characterPrimary,
  charactersMeta,
  url,
  type AssetEntry,
} from "../lib/assets";

interface Slide {
  entry: AssetEntry;
  slug: string;
  color: string;
  kicker: string;
  nameJa: string;
  nameEn: string;
  part: string;
  tagline: string;
  href: string;
  cta: string;
}

interface Props {
  slides?: Slide[];
  interval?: number;
}

// 每名成员一屏。part 取 manifest 官方定位，tagline 为角色印象短句。
const TAGLINES: Record<string, string> = {
  nina: "怒りも、悲しみも、全部ぶつけろ。",
  momoka: "音楽への嘘は、つかない。",
  subaru: "頑張るあなたの、隣に。",
  tomo: "私の歌で、届けたい。",
  rupa: "心のままに、刻もう。",
};
const ORDER = ["nina", "momoka", "subaru", "tomo", "rupa"];

const defaultSlides: Slide[] = ORDER.map((slug) => {
  const meta = (charactersMeta as any)[slug];
  const entry = characterPrimary(slug);
  return {
    entry: entry!,
    slug,
    color: meta?.color ?? "#D90E2C",
    kicker: meta?.part ? `${meta.part.toUpperCase?.() ?? meta.part}` : "TOGENASHI TOGEARI",
    nameJa: meta?.ja ?? slug,
    nameEn: meta?.romaji ?? meta?.en ?? "",
    part: meta?.part ?? "",
    tagline: TAGLINES[slug] ?? "",
    href: `/characters#${slug}`,
    cta: `认识${meta?.ja ?? slug}`,
  };
}).filter((s) => s.entry);

const { slides = defaultSlides, interval = 6000 } = Astro.props;
---

<section class="hero halftone" data-carousel data-interval={interval} aria-roledescription="carousel" aria-label="成员轮播">
  {
    slides.map((s, i) => (
      <div
        class="hero__slide"
        data-slide
        data-active={i === 0 ? "" : undefined}
        aria-hidden={i !== 0 ? "true" : "false"}
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} / ${slides.length} ${s.nameJa}`}
        style={`--c:${s.color}`}
      >
        {/* 角色主题色的氛围底(低饱和，不抢立绘) */}
        <div class="hero__bg" aria-hidden="true" />

        <div class="hero__inner container">
          {/* 左：文案 */}
          <div class="hero__copy">
            <p class="hero__kicker label">{s.kicker}</p>
            {i === 0 ? (
              <h1 class="hero__name">
                <span class="hero__name-ja">{s.nameJa}</span>
                <span class="hero__name-en">{s.nameEn}</span>
              </h1>
            ) : (
              <p class="hero__name" role="heading" aria-level="2">
                <span class="hero__name-ja">{s.nameJa}</span>
                <span class="hero__name-en">{s.nameEn}</span>
              </p>
            )}
            <p class="hero__tagline">{s.tagline}</p>
            <a class="btn btn--primary hero__cta" href={url(s.href)}>
              {s.cta}
            </a>
          </div>

          {/* 右：立绘（完整展示，不裁切） */}
          <figure class="hero__art">
            <img
              src={assetUrl(s.entry.path)}
              alt={`${s.nameJa} 立绘`}
              width={s.entry.width}
              height={s.entry.height}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
              decoding="async"
            />
          </figure>
        </div>
      </div>
    ))
  }

  <div class="hero__controls container">
    <button class="hero__arrow" type="button" data-carousel-prev aria-label="上一张">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M15 5l-7 7 7 7" />
      </svg>
    </button>
    <div class="hero__dots" role="tablist" aria-label="选择成员">
      {
        slides.map((s, i) => (
          <button
            class="hero__dot"
            type="button"
            data-dot
            role="tab"
            style={`--c:${s.color}`}
            aria-current={i === 0 ? "true" : "false"}
            aria-label={s.nameJa}
          />
        ))
      }
    </div>
    <button class="hero__arrow" type="button" data-carousel-next aria-label="下一张">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--ink-950);
    overflow: hidden;
    /* 移动端不宜过高(用户反馈影响观感)：内容自适应 + 上限，不再 78svh 撑满 */
    min-height: 0;
    display: grid;
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: 90svh;
    }
  }

  /* 每张 slide 全幅叠放，交叉淡入。
     注意：首屏 slide 必须在文档流内撑起 .hero 高度(否则 hero 塌陷为 0)，
     故默认 relative 占位；非激活的用 absolute 叠在同一位置。 */
  .hero__slide {
    position: relative;
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity var(--dur-enter) var(--ease-out-expo);
    display: grid;
    visibility: hidden;
  }

  .hero__slide[data-active] {
    opacity: 1;
    z-index: 1;
    visibility: visible;
  }

  /* 角色主题色的氛围底：左深右浅对角渐变 + 大块色晕，低饱和不抢立绘 */
  .hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(58% 78% at 76% 42%, color-mix(in oklab, var(--c) 34%, transparent), transparent 70%),
      linear-gradient(112deg, var(--ink-950) 34%, color-mix(in oklab, var(--c) 16%, var(--ink-950)) 100%);
  }

  /* 左文案 + 右立绘的杂志式栅格。
     移动端：文案左(限宽 62%)，立绘贴右下并延伸到底缘、底缘渐隐，
     硬边消失，像"站出画面"，不会被看成断臂/硬切。 */
  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    align-content: center;
    gap: var(--sp-4);
    width: 100%;
    /* 底部留白给绝对定位的控制条，避免压住 CTA(用户反馈重叠) */
    padding-block: var(--sp-5) calc(var(--sp-4) + 52px);
  }

  .hero__copy {
    grid-area: 1 / 1;
    max-width: 62%;
  }

  .hero__copy {
    max-width: 34em;
    animation: hero-copy-in var(--dur-enter) var(--ease-out-expo) both;
  }

  @keyframes hero-copy-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  .hero__kicker {
    color: var(--c);
    margin-bottom: var(--sp-3);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.14em;
  }

  .hero__name {
    margin: 0;
    display: grid;
    gap: var(--sp-2);
    line-height: 1.0;
  }

  .hero__name-ja {
    /* 移动端名字用次大显示字阶，避免日文名过长撑高(用户反馈整体过高) */
    font-size: clamp(2.4rem, 11vw, var(--fs-display));
    font-weight: var(--fw-black);
    letter-spacing: -0.02em;
    word-break: keep-all;
    text-shadow: 0 2px 32px rgba(0, 0, 0, 0.5);
  }

  .hero__name-en {
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.3em;
    color: var(--c);
    text-transform: uppercase;
  }

  .hero__tagline {
    margin-top: var(--sp-3);
    color: var(--ink-200);
    font-size: var(--fs-body);
    max-width: 24em;
    word-break: keep-all;
  }

  .hero__cta {
    margin-top: var(--sp-4);
    justify-self: start;
  }

  /* 立绘：移动端贴右下、延伸到底缘，底缘渐隐融入(消除硬切/断臂观感) */
  .hero__art {
    grid-area: 1 / 1;
    margin: 0;
    /* 负外边距把立绘拉到 hero 最底缘(抵消 inner 底部为控制条留的白) */
    margin-bottom: calc(-1 * (var(--sp-4) + 52px));
    margin-right: calc(-1 * var(--container-pad));
    display: grid;
    justify-items: end;
    align-items: end;
    order: 0;
    justify-self: end;
    width: 58%;
    pointer-events: none;
  }

  .hero__art img {
    height: 100%;
    width: 100%;
    max-height: 46svh;
    object-fit: contain;
    object-position: bottom right;
    /* 底缘 1/4 渐隐：立绘下缘融入背景，不出现硬切边 */
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
    filter: drop-shadow(0 12px 40px rgba(0, 0, 0, 0.55));
    animation: hero-art-in var(--dur-enter) var(--ease-out-expo) both;
  }

  @keyframes hero-art-in {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.98);
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: center;
      gap: var(--sp-7);
      /* 底部多留 64px 给固定播放条，立绘不被它切到 */
      padding-block: var(--sp-6) calc(var(--sp-6) + 64px);
    }

    /* 桌面回到两列独立排布：文案左列、立绘右列 */
    .hero__copy,
    .hero__art {
      grid-area: auto;
    }

    .hero__copy {
      max-width: 30em;
    }

    .hero__art {
      margin: 0;
      justify-self: center;
      width: auto;
      max-width: 100%;
      pointer-events: auto;
    }

    .hero__art img {
      /* 62svh 保证立绘底缘停在播放条之上，不被切 */
      max-height: 62svh;
      /* 素材本身是半身立绘(到大腿截断)，底缘渐隐化解硬边 */
      -webkit-mask-image: linear-gradient(to bottom, #000 86%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 86%, transparent 100%);
    }

    .hero__name-ja {
      /* 桌面恢复满显示字阶 */
      font-size: var(--fs-display);
    }
  }

  /* 控制条：移动端在文案之下，桌面抬到固定播放条之上(否则被它盖住) */
  .hero__controls {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: var(--sp-4);
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  @media (min-width: 1024px) {
    .hero__controls {
      bottom: calc(var(--sp-4) + 64px);
    }
  }

  .hero__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    color: var(--ink-000);
    background: rgba(14, 15, 19, 0.4);
    backdrop-filter: blur(8px);
    transition:
      background-color var(--dur-base) var(--ease-out-cubic),
      border-color var(--dur-base) var(--ease-out-cubic);
  }

  .hero__arrow:hover {
    background: var(--gbc-red);
    border-color: var(--gbc-red);
  }

  .hero__dots {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .hero__dot {
    width: 28px;
    height: 4px;
    padding-block: 20px;
    padding-inline: 4px;
    box-sizing: content-box;
    background: rgba(255, 255, 255, 0.28);
    background-clip: content-box;
    transition: background-color var(--dur-base) var(--ease-out-cubic);
  }

  /* 当前指示点用该成员的主题色，五人五色 */
  .hero__dot[aria-current="true"] {
    background-color: var(--c, var(--gbc-red));
  }

  .hero__dot:hover {
    background-color: var(--ink-300);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      transition: none;
    }
    .hero__copy,
    .hero__art img {
      animation: none;
    }
  }
</style>
