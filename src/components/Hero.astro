---
/**
 * Hero 角色轮播（杂志式：左文案 + 右立绘）
 *  - 5 名成员各一屏：角色立绘(完整 contain，不 cover 裁切) + 角色主题色 + 标语
 *  - 解决旧 cover 全屏的痛点：特写失焦、文字压脸、人物被裁只剩 1/3
 *  - 自动轮播 6s；悬停/聚焦/切后台暂停；← → 键盘可切；圆点为 button
 *  - prefers-reduced-motion：不自动轮播、不做位移动画
 */
import { t } from "../i18n";
import {
  assetUrl,
  contentSizes,
  srcset,
  characterPrimary,
  charactersMeta,
  url,
  type AssetEntry,
} from "../lib/assets";

interface Slide {
  entry: AssetEntry;
  slug: string;
  color: string;
  kicker: string;
  nameJa: string;
  nameEn: string;
  part: string;
  tagline: string;
  href: string;
  cta: string;
  /** 素材左缘有切边时置 true：水平镜像，让切边落到被钉住的右缘。 */
  mirror?: boolean;
}

interface Props {
  slides?: Slide[];
  interval?: number;
}

// 每名成员一屏。part 取 manifest 官方定位，tagline 为角色印象短句。
/* 五句角色标语已进词典（hero.tagline.<slug>，三语），这里只取中文做 SSR 兜底 */
const taglineOf = (slug: string): string => t(`hero.tagline.${slug}`);
const ORDER = ["nina", "momoka", "subaru", "tomo", "rupa"];

/**
 * 需要水平镜像的成员。
 * 昴的立绘素材(19-koyubi)左缘把她的手臂切断了，而 hero 把立绘钉在右侧、
 * 切边会正对文字一侧暴露出来；镜像后切边移到右侧，与露帕(rupa)立绘原本
 * 就在右缘的切边一样被画面边缘吃掉。
 */
const MIRRORED = new Set(["subaru"]);

const defaultSlides: Slide[] = ORDER.map((slug) => {
  const meta = (charactersMeta as any)[slug];
  const entry = characterPrimary(slug);
  return {
    entry: entry!,
    slug,
    mirror: MIRRORED.has(slug),
    color: meta?.color ?? "#D90E2C",
    kicker: meta?.part ? `${meta.part.toUpperCase?.() ?? meta.part}` : "TOGENASHI TOGEARI",
    nameJa: meta?.ja ?? slug,
    nameEn: meta?.romaji ?? meta?.en ?? "",
    part: meta?.part ?? "",
    tagline: taglineOf(slug),
    href: `/characters#${slug}`,
    cta: `认识${meta?.ja ?? slug}`,
  };
}).filter((s) => s.entry);

const { slides = defaultSlides, interval = 6000 } = Astro.props;
---

<section
  class="hero halftone"
  data-carousel
  data-interval={interval}
  aria-roledescription="carousel"
  data-i18n-attr="aria-label:hero.aria.carousel"
  aria-label="成员轮播"
>
  {
    slides.map((s, i) => (
      <div
        class="hero__slide"
        data-slide
        data-active={i === 0 ? "" : undefined}
        aria-hidden={i !== 0 ? "true" : "false"}
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} / ${slides.length} ${s.nameJa}`}
        style={`--c:${s.color}`}
      >
        {/* 角色主题色的氛围底(低饱和，不抢立绘) */}
        <div class="hero__bg" aria-hidden="true" />

        <div class="hero__inner container">
          {/* 左：文案 */}
          <div class="hero__copy">
            <p class="hero__kicker label">{s.kicker}</p>
            {i === 0 ? (
              <h1 class="hero__name">
                <span class="hero__name-ja">{s.nameJa}</span>
                <span class="hero__name-en">{s.nameEn}</span>
              </h1>
            ) : (
              <p class="hero__name" role="heading" aria-level="2">
                <span class="hero__name-ja">{s.nameJa}</span>
                <span class="hero__name-en">{s.nameEn}</span>
              </p>
            )}
            <p class="hero__tagline" data-i18n={`hero.tagline.${s.slug}`}>{s.tagline}</p>
            {/* 日文名是设计元素，中文/日文界面保留；英文界面用罗马音，
                否则会出现「Meet 井芹仁菜」这种半英半中的按钮 */}
            <a class="btn btn--primary hero__cta" href={url(s.href)}>
              <span data-i18n="hero.cta.prefix">认识</span><span class="hero__cta-ja">{s.nameJa}</span><span class="hero__cta-en">{s.nameEn}</span>
            </a>
          </div>

          {/* 右：立绘（完整展示，不裁切；mirror 时水平翻转并钉到右缘） */}
          <figure class="hero__art" data-mirror={s.mirror ? "" : undefined}>
            <img
              src={assetUrl(s.entry.path)}
              srcset={srcset(s.entry.path)}
              sizes={contentSizes(s.entry, [210, 305], [480, 666])}
              data-i18n-attr="alt:hero.art.alt"
              data-i18n-vars={`name:${s.nameJa}`}
              alt={`${s.nameJa} 立绘`}
              width={s.entry.width}
              height={s.entry.height}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
              decoding="async"
            />
          </figure>
        </div>
      </div>
    ))
  }

  <div class="hero__controls container">
    <button
      class="hero__arrow"
      type="button"
      data-carousel-prev
      data-i18n-attr="aria-label:hero.aria.prev"
      aria-label="上一张"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M15 5l-7 7 7 7" />
      </svg>
    </button>
    <div
      class="hero__dots"
      role="tablist"
      data-i18n-attr="aria-label:hero.aria.dots"
      aria-label="选择成员"
    >
      {
        slides.map((s, i) => (
          <button
            class="hero__dot"
            type="button"
            data-dot
            role="tab"
            style={`--c:${s.color}`}
            aria-current={i === 0 ? "true" : "false"}
            aria-label={s.nameJa}
          />
        ))
      }
    </div>
    <button
      class="hero__arrow"
      type="button"
      data-carousel-next
      data-i18n-attr="aria-label:hero.aria.next"
      aria-label="下一张"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--ink-950);
    overflow: hidden;
    /* 移动端不宜过高(用户反馈影响观感)：内容自适应 + 上限，不再 78svh 撑满 */
    min-height: 0;
    display: grid;
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: 90svh;
    }
  }

  /* 每张 slide 全幅叠放，交叉淡入。
     注意：首屏 slide 必须在文档流内撑起 .hero 高度(否则 hero 塌陷为 0)，
     故默认 relative 占位；非激活的用 absolute 叠在同一位置。 */
  .hero__slide {
    position: relative;
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity var(--dur-enter) var(--ease-out-expo);
    display: grid;
    visibility: hidden;
  }

  .hero__slide[data-active] {
    opacity: 1;
    z-index: 1;
    visibility: visible;
  }

  /* 角色主题色的氛围底：左深右浅对角渐变 + 大块色晕，低饱和不抢立绘 */
  .hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(58% 78% at 76% 42%, color-mix(in oklab, var(--c) 34%, transparent), transparent 70%),
      linear-gradient(112deg, var(--ink-950) 34%, color-mix(in oklab, var(--c) 16%, var(--ink-950)) 100%);
  }

  /* 左文案 + 右立绘的杂志式栅格。
     移动端：文案左(限宽 62%)，立绘贴右下并延伸到底缘、底缘渐隐，
     硬边消失，像"站出画面"，不会被看成断臂/硬切。 */
  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    align-content: center;
    gap: var(--sp-4);
    width: 100%;
    /* 底部留白给绝对定位的控制条，避免压住 CTA(用户反馈重叠) */
    padding-block: var(--sp-5) calc(var(--sp-4) + 52px);
  }

  .hero__copy {
    grid-area: 1 / 1;
    max-width: 62%;
  }

  .hero__copy {
    max-width: 34em;
    animation: hero-copy-in var(--dur-enter) var(--ease-out-expo) both;
  }

  @keyframes hero-copy-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  .hero__kicker {
    color: var(--c);
    margin-bottom: var(--sp-3);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.14em;
  }

  .hero__name {
    margin: 0;
    display: grid;
    gap: var(--sp-2);
    line-height: 1.0;
  }

  .hero__name-ja {
    /* 移动端名字用次大显示字阶，避免日文名过长撑高(用户反馈整体过高) */
    font-size: clamp(2.4rem, 11vw, var(--fs-display));
    font-weight: var(--fw-black);
    letter-spacing: -0.02em;
    word-break: keep-all;
    text-shadow: 0 2px 32px rgba(0, 0, 0, 0.5);
  }

  .hero__name-en {
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.3em;
    color: var(--c);
    text-transform: uppercase;
  }

  /* 手机端罗马音名不能铺满整行：立绘从约 50% 处压上来，
     KAWARAGI MOMOKA 会被头发吃掉一半。收在左栏内、允许按空格折两行。 */
  @media (max-width: 1023.98px) {
    .hero__name-en {
      max-width: 46%;
      font-size: var(--fs-sm);
      letter-spacing: 0.2em;
      line-height: 1.6;
      text-wrap: balance;
    }
  }

  .hero__tagline {
    margin-top: var(--sp-3);
    color: var(--ink-200);
    font-size: var(--fs-body);
    max-width: 24em;
    word-break: keep-all;
  }

  /* 手机端文案列只占左半边，立绘压在上面：标语宽度收到文案列内换行，
     否则英文标语会伸到立绘底下被盖住（日文标语短，看不出来） */
  @media (max-width: 1023.98px) {
    .hero__tagline {
      max-width: 47%;
      text-wrap: balance;
    }
  }

  .hero__cta {
    margin-top: var(--sp-4);
    justify-self: start;
  }

  .hero__cta-en {
    display: none;
  }

  /* 语言切换是 html[data-lang] 驱动的，不刷新、不重渲染，这里同步换名 */
  :global(html[data-lang="en"]) .hero__cta-ja {
    display: none;
  }

  :global(html[data-lang="en"]) .hero__cta-en {
    display: inline;
  }

  /* 立绘：移动端贴右下、延伸到底缘，底缘渐隐融入(消除硬切/断臂观感) */
  .hero__art {
    grid-area: 1 / 1;
    margin: 0;
    /* 负外边距把立绘拉到 hero 最底缘(抵消 inner 底部为控制条留的白) */
    margin-bottom: calc(-1 * (var(--sp-4) + 52px));
    margin-right: calc(-1 * var(--container-pad));
    display: grid;
    justify-items: end;
    align-items: end;
    order: 0;
    justify-self: end;
    width: 58%;
    pointer-events: none;
  }

  .hero__art img {
    height: 100%;
    width: 100%;
    max-height: 46svh;
    object-fit: contain;
    object-position: bottom right;
    /* 底缘 1/4 渐隐：立绘下缘融入背景，不出现硬切边 */
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
    filter: drop-shadow(0 12px 40px rgba(0, 0, 0, 0.55));
    animation: hero-art-in var(--dur-enter) var(--ease-out-expo) both;
  }

  /* 素材左缘把手臂切断的成员：水平镜像，让切边落到被钉住的右缘 */
  .hero__art[data-mirror] {
    transform: scaleX(-1);
  }

  @keyframes hero-art-in {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.98);
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: center;
      gap: var(--sp-7);
      padding-block: var(--sp-7);
    }

    /* 桌面回到两列独立排布：文案左列、立绘右列 */
    .hero__copy,
    .hero__art {
      grid-area: auto;
    }

    .hero__copy {
      max-width: 30em;
    }

    .hero__art {
      margin: 0;
      justify-self: center;
      width: auto;
      max-width: 100%;
      pointer-events: auto;
    }

    .hero__art img {
      /* 播放条已移除，立绘可用满高度 */
      max-height: 74svh;
      /* 素材本身是半身立绘(到大腿截断)，底缘渐隐化解硬边 */
      -webkit-mask-image: linear-gradient(to bottom, #000 86%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 86%, transparent 100%);
    }

    /* 镜像立绘贴到版面右缘：素材切边与版面边缘重合，不再露在画面中间 */
    .hero__art[data-mirror] {
      justify-self: end;
      margin-right: calc(-1 * var(--container-pad));
    }

    .hero__name-ja {
      /* 桌面恢复满显示字阶 */
      font-size: var(--fs-display);
    }
  }

  /* 控制条：移动端在文案之下，桌面抬到固定播放条之上(否则被它盖住) */
  .hero__controls {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: var(--sp-4);
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .hero__arrow {
    display: grid;
    place-items: center;
    /* 不许被 flex 容器压缩：手机上曾把 44px 挤成 29px，触控目标不达标 */
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    color: var(--ink-000);
    background: rgba(14, 15, 19, 0.4);
    backdrop-filter: blur(8px);
    transition:
      background-color var(--dur-base) var(--ease-out-cubic),
      border-color var(--dur-base) var(--ease-out-cubic);
  }

  .hero__arrow:hover {
    background: var(--gbc-red);
    border-color: var(--gbc-red);
  }

  .hero__dots {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .hero__dot {
    width: 28px;
    height: 4px;
    padding-block: 20px;
    padding-inline: 8px; /* 触控目标：28 + 8×2 = 44 宽 */
    box-sizing: content-box;
    background: rgba(255, 255, 255, 0.28);
    background-clip: content-box;
    transition: background-color var(--dur-base) var(--ease-out-cubic);
  }

  /* 当前指示点用该成员的主题色，五人五色 */
  .hero__dot[aria-current="true"] {
    background-color: var(--c, var(--gbc-red));
  }

  .hero__dot:hover {
    background-color: var(--ink-300);
  }

  /* ≤479px：5 个 44px 触控区 + 两只箭头 + 容器内边距合计约 420px，
     390 宽时右侧箭头被裁掉 6px，360 宽时被裁掉 36px（实测）。
     窄屏把圆点收窄、间距压紧，圆点组吃掉中间剩余空间并居中，
     左右箭头始终贴住容器两侧，320 宽也不会再出屏。 */
  @media (max-width: 479.98px) {
    .hero__controls {
      gap: var(--sp-2);
    }

    .hero__dots {
      flex: 1 1 auto;
      justify-content: center;
      gap: 2px;
    }

    .hero__dot {
      width: 18px;
      padding-inline: 5px; /* 触控目标：18 + 5×2 = 28 宽 × 44 高 */
    }

    /* 桃香的名字比仁菜长一个字，320 宽下 CTA 会比文案列宽出 35px，
       压到立绘上；收窄左右内边距（64 → 32），5 张都能留在左半边。 */
    .hero__cta {
      padding-inline: var(--sp-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      transition: none;
    }
    .hero__copy,
    .hero__art img {
      animation: none;
    }
  }
</style>
