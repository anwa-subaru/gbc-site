---
/**
 * 音乐播放器
 *  - <1024px：底部迷你条（封面 + 标题 + 播放/暂停 + 顶部进度线）
 *  - ≥1024px：完整条（上一首 / 播放 / 下一首 + 可拖拽进度 + 音量）
 *  - 曲目来自角色 PV（资产库无独立音源，见 player.ts 说明）
 *  - 播放时用 --track-color 点亮角色代表色
 */
import { pvTracks, characterPrimary, assetUrl, url } from "../lib/assets";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const tracks = pvTracks().map((t) => ({
  ...t,
  cover: (() => {
    const art = characterPrimary(t.slug);
    return art ? assetUrl(art.path) : "";
  })(),
}));

// 默认封面：第一首的立绘，避免首帧空白
const fallbackCover = tracks[0]?.cover ?? "";
---

<div class="mp" data-player style={`--track-color:${tracks[0]?.color ?? "var(--gbc-red)"}`}>
  <audio data-player-audio preload="none"></audio>

  <!-- 进度线：移动端可见，桌面端由滑杆承担 -->
  <span class="mp__progress" aria-hidden="true"></span>

  <div class="mp__inner container">
    <div class="mp__meta">
      <img
        class="mp__cover"
        data-player-cover
        src={fallbackCover}
        alt=""
        width="96"
        height="96"
        loading="lazy"
        decoding="async"
      />
      <div class="mp__text">
        <p class="mp__title" data-player-title>{tracks[0]?.title ?? "—"}</p>
        <p class="mp__sub" data-player-subtitle>{tracks[0]?.subtitle ?? ""}</p>
      </div>
    </div>

    <div class="mp__transport">
      <button class="mp__btn mp__btn--step" type="button" data-player-prev aria-label="上一首">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path d="M6 5h2v14H6zM20 5v14l-11-7z" />
        </svg>
      </button>

      <button class="mp__btn mp__btn--play" type="button" data-player-toggle aria-pressed="false" aria-label="播放">
        <svg class="mp__icon mp__icon--play" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor">
          <path d="M7 4l13 8-13 8z" />
        </svg>
        <svg class="mp__icon mp__icon--pause" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor">
          <path d="M6 4h4v16H6zM14 4h4v16h-4z" />
        </svg>
      </button>

      <button class="mp__btn mp__btn--step" type="button" data-player-next aria-label="下一首">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path d="M16 5h2v14h-2zM4 5l11 7-11 7z" />
        </svg>
      </button>
    </div>

    <div class="mp__seek">
      <span class="mp__time num" data-player-current>0:00</span>
      <input
        class="mp__range"
        type="range"
        min="0"
        max="100"
        step="0.1"
        value="0"
        data-player-seek
        aria-label="播放进度"
        aria-valuetext="0:00"
      />
      <span class="mp__time num" data-player-duration>0:00</span>
    </div>

    <div class="mp__volume">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
        <path d="M4 9h3l5-4v14l-5-4H4zM16 8.5a5 5 0 010 7" fill="none" stroke="currentColor" stroke-width="2" />
      </svg>
      <input
        class="mp__range mp__range--vol"
        type="range"
        min="0"
        max="100"
        value="80"
        data-player-volume
        aria-label="音量"
      />
    </div>

    <a class="mp__more label" href={url("/music")}>ALL PV</a>
  </div>
</div>

<script type="application/json" data-player-tracks set:html={JSON.stringify(tracks)} />

<style>
  .mp {
    --progress: 0%;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    background: rgba(8, 9, 11, 0.94);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-top: 1px solid var(--border);
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  /* 顶部进度线 */
  .mp__progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: var(--progress);
    background: var(--track-color);
    transition: width 120ms linear;
  }

  .mp__inner {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    height: 64px;
  }

  .mp__meta {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-width: 0;
    flex: 1 1 auto;
  }

  .mp__cover {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    object-fit: contain;
    object-position: center bottom;
    background: var(--ink-850);
    border: 1px solid var(--border);
  }

  .mp__text {
    min-width: 0;
  }

  .mp__title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    letter-spacing: 0.01em;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mp__sub {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--ink-300);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mp__transport {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    flex: 0 0 auto;
  }

  .mp__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--ink-000);
    transition: color var(--dur-base) var(--ease-out-cubic);
  }

  .mp__btn:hover {
    color: var(--track-color);
  }

  .mp__btn--play {
    width: 48px;
    height: 48px;
    background: var(--track-color);
    color: var(--ink-000);
    transition: transform var(--dur-fast) var(--ease-out-cubic);
  }

  .mp__btn--play:hover {
    color: var(--ink-000);
    transform: scale(1.04);
  }

  /* 播放/暂停图标按状态切换 */
  .mp__icon--pause,
  .mp[data-playing] .mp__icon--play {
    display: none;
  }

  .mp[data-playing] .mp__icon--pause {
    display: block;
  }

  /* 移动端隐藏桌面专属控件 */
  .mp__btn--step,
  .mp__seek,
  .mp__volume,
  .mp__more {
    display: none;
  }

  @media (min-width: 1024px) {
    .mp__inner {
      height: 80px;
      gap: var(--sp-5);
    }

    .mp__cover {
      width: 56px;
      height: 56px;
    }

    .mp__btn--step,
    .mp__seek {
      display: flex;
    }

    .mp__volume,
    .mp__more {
      display: flex;
    }

    .mp__meta {
      flex: 0 1 260px;
    }

    .mp__transport {
      flex: 0 0 auto;
      gap: var(--sp-2);
    }

    .mp__seek {
      flex: 1 1 auto;
      align-items: center;
      gap: var(--sp-3);
    }

    .mp__volume {
      flex: 0 0 auto;
      align-items: center;
      gap: var(--sp-2);
      color: var(--ink-300);
    }

    .mp__more {
      flex: 0 0 auto;
      color: var(--ink-300);
      border: 1px solid var(--border);
      padding: var(--sp-2) var(--sp-3);
      transition:
        color var(--dur-base) var(--ease-out-cubic),
        border-color var(--dur-base) var(--ease-out-cubic);
    }

    .mp__more:hover {
      color: var(--ink-000);
      border-color: var(--gbc-red);
    }
  }

  .mp__time {
    font-size: var(--fs-xs);
    color: var(--ink-300);
    letter-spacing: 0.06em;
    flex: 0 0 auto;
  }

  /* ---- 滑杆 ---- */
  .mp__range {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 20px;
    background: transparent;
    cursor: pointer;
  }

  .mp__range--vol {
    width: 72px;
  }

  .mp__range::-webkit-slider-runnable-track {
    height: 3px;
    background: var(--ink-600);
  }

  .mp__range::-moz-range-track {
    height: 3px;
    background: var(--ink-600);
  }

  .mp__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    margin-top: -4.5px;
    background: var(--ink-000);
    border-radius: var(--r-pill);
    transition: background-color var(--dur-base) var(--ease-out-cubic);
  }

  .mp__range::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 0;
    background: var(--ink-000);
    border-radius: var(--r-pill);
  }

  .mp__range:hover::-webkit-slider-thumb {
    background: var(--track-color);
  }
  .mp__range:hover::-moz-range-thumb {
    background: var(--track-color);
  }

  @media (prefers-reduced-motion: reduce) {
    .mp__progress {
      transition: none;
    }
    .mp__btn--play:hover {
      transform: none;
    }
  }
</style>
