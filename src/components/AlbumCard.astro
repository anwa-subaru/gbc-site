---
/**
 * 专辑 / 封面卡
 *  - 方形封面，悬停放大 1.04 + 红色扫描条（320ms ease-out-expo）
 *  - 无 href 时降级为非交互容器（不产生假的链接语义）
 *  - 传 playTrack 时渲染成 <button>：点击直接让页面播放器播放该曲
 */
import { assetUrl, url, type AssetEntry } from "../lib/assets";

interface Props {
  entry: AssetEntry;
  title?: string;
  subtitle?: string;
  badge?: string;
  href?: string;
  index?: number;
  eager?: boolean;
  /** 点击后要播放的曲目号（songs.json 的 n），不传则不可播放 */
  playTrack?: number;
  /** 实际会播放的曲名，用于提示与无障碍标签 */
  playLabel?: string;
}

const {
  entry,
  title,
  subtitle,
  badge,
  href,
  index = 0,
  eager = false,
  playTrack,
  playLabel,
} = Astro.props;

const cleanTitle = title ?? entry.source_name.replace(/\.[^.]+$/, "");
const autoBadge = entry.path.includes("/album/")
  ? "ALBUM"
  : entry.path.includes("/bd/")
    ? "BLU-RAY"
    : entry.path.includes("/pv/")
      ? "PV"
      : "COVER";
const typeBadge = badge ?? autoBadge;

const playable = typeof playTrack === "number" && playTrack > 0;
const Tag = playable ? "button" : href ? "a" : "div";
const label = playable
  ? `播放 ${playLabel ?? cleanTitle}`
  : href
    ? cleanTitle
    : undefined;
---

<article class="ac" style={`--i:${index}`} data-reveal>
  <Tag
    class="ac__link"
    href={href ? url(href) : undefined}
    type={playable ? "button" : undefined}
    data-play={playable ? playTrack : undefined}
    aria-label={label}
    title={playable ? `播放：${playLabel ?? cleanTitle}` : undefined}
  >
    <div class="ac__frame">
      <img
        class="ac__img"
        src={assetUrl(entry.path)}
        alt={cleanTitle}
        width={entry.width}
        height={entry.height}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
      <span class="ac__badge label">{typeBadge}</span>
      {
        playable && (
          <span class="ac__play" aria-hidden="true">
            <svg class="ac__i-play" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M8 5.2v13.6L19 12z" />
            </svg>
            <svg class="ac__i-pause" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M7 4.5h3.4v15H7zM13.6 4.5H17v15h-3.4z" />
            </svg>
          </span>
        )
      }
      <span class="ac__scan" aria-hidden="true"></span>
    </div>
    <div class="ac__body">
      <h3 class="ac__title">{cleanTitle}</h3>
      {subtitle && <p class="ac__sub">{subtitle}</p>}
    </div>
  </Tag>
</article>

<style>
  .ac {
    min-width: 0;
  }

  .ac__link {
    display: block;
    color: inherit;
  }

  /* 可播放的卡片渲染成 <button>，清掉浏览器默认样式 */
  button.ac__link {
    width: 100%;
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .ac__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin: -23px 0 0 -23px;
    border-radius: 50%;
    background: var(--gbc-red);
    color: #fff;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.45);
    opacity: 0;
    transform: scale(0.86);
    transition:
      opacity var(--dur-base) var(--ease-out-cubic),
      transform var(--dur-base) var(--ease-out-cubic);
    pointer-events: none;
  }

  .ac__link:hover .ac__play,
  .ac__link:focus-visible .ac__play {
    opacity: 1;
    transform: scale(1);
  }

  /* 触屏没有 hover：常驻显示，否则用户不知道封面能点 */
  @media (hover: none) {
    .ac__play {
      opacity: 1;
      transform: scale(1);
      width: 38px;
      height: 38px;
      margin: -19px 0 0 -19px;
      background: color-mix(in srgb, var(--gbc-red) 88%, transparent);
    }
  }

  /* 正在播放的那张：描边高亮 + 播放键常驻，且切换成暂停图标 */
  .ac.is-playing .ac__frame {
    border-color: var(--gbc-red);
  }

  .ac.is-playing .ac__play {
    opacity: 1;
    transform: scale(1);
  }

  .ac.is-playing:not(.is-paused) .ac__play {
    animation: ac-pulse 1.8s var(--ease-out-cubic) infinite;
  }

  .ac__i-pause {
    display: none;
  }

  .ac.is-playing:not(.is-paused) .ac__i-play {
    display: none;
  }

  .ac.is-playing:not(.is-paused) .ac__i-pause {
    display: block;
  }

  @keyframes ac-pulse {
    0%,
    100% {
      box-shadow: 0 6px 20px rgb(0 0 0 / 0.45), 0 0 0 0 rgb(244 0 0 / 0.5);
    }
    60% {
      box-shadow: 0 6px 20px rgb(0 0 0 / 0.45), 0 0 0 14px rgb(244 0 0 / 0);
    }
  }

  .ac__frame {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--ink-850);
    border: 1px solid var(--border);
    transition: border-color var(--dur-base) var(--ease-out-cubic);
  }

  .ac__link:hover .ac__frame {
    border-color: var(--gbc-red);
  }

  .ac__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }

  .ac__link:hover .ac__img {
    transform: scale(1.04);
  }

  .ac__badge {
    position: absolute;
    top: var(--sp-2);
    left: var(--sp-2);
    padding: 3px var(--sp-2);
    background: rgba(14, 15, 19, 0.8);
    color: var(--ink-100);
    backdrop-filter: blur(4px);
    border-radius: var(--r-sm);
  }

  /* 底部红色扫描条：悬停自左向右展开 */
  .ac__scan {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--gbc-red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }

  .ac__link:hover .ac__scan {
    transform: scaleX(1);
  }

  .ac__body {
    padding-top: var(--sp-3);
  }

  .ac__title {
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    letter-spacing: 0.01em;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ac__sub {
    margin-top: var(--sp-1);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--ink-300);
  }

  @media (prefers-reduced-motion: reduce) {
    .ac__img,
    .ac__scan,
    .ac__play {
      transition: none;
    }
    /* 选择器要和上面的脉冲规则同权重，否则压不住 */
    .ac.is-playing:not(.is-paused) .ac__play {
      animation: none;
    }    .ac__link:hover .ac__img {
      transform: none;
    }
    .ac__link:hover .ac__scan {
      transform: scaleX(1);
    }
  }
</style>
