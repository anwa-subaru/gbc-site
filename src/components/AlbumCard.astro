---
/**
 * 专辑 / 封面卡
 *  - 方形封面，悬停放大 1.04 + 红色扫描条（320ms ease-out-expo）
 *  - 无 href 时降级为非交互容器（不产生假的链接语义）
 *  - 传 playTrack 时渲染成 <button>：点击直接让页面播放器播放该曲
 */
import { assetUrl, url, type AssetEntry } from "../lib/assets";

interface Props {
  entry: AssetEntry;
  title?: string;
  subtitle?: string;
  badge?: string;
  href?: string;
  index?: number;
  eager?: boolean;
  /** 点击后要播放的曲目号（songs.json 的 n），不传则不可播放 */
  playTrack?: number;
  /** 实际会播放的曲名，用于提示与无障碍标签 */
  playLabel?: string;
}

const {
  entry,
  title,
  subtitle,
  badge,
  href,
  index = 0,
  eager = false,
  playTrack,
  playLabel,
} = Astro.props;

const cleanTitle = title ?? entry.source_name.replace(/\.[^.]+$/, "");
const autoBadge = entry.path.includes("/album/")
  ? "ALBUM"
  : entry.path.includes("/bd/")
    ? "BLU-RAY"
    : entry.path.includes("/pv/")
      ? "PV"
      : "COVER";
const typeBadge = badge ?? autoBadge;

const playable = typeof playTrack === "number" && playTrack > 0;
/* 渐变 id 要全页唯一（同页 15 张可播放封面），否则多卡 SVG 引用串线 */
const gid = `spk-${playable ? playTrack : "x"}`;
const Tag = playable ? "button" : href ? "a" : "div";
const label = playable
  ? `双击播放 ${playLabel ?? cleanTitle}`
  : href
    ? cleanTitle
    : undefined;
---

<article class="ac" style={`--i:${index}`} data-reveal>
  <Tag
    class="ac__link"
    href={href ? url(href) : undefined}
    type={playable ? "button" : undefined}
    data-play={playable ? playTrack : undefined}
    aria-label={label}
    title={playable ? `双击播放：${playLabel ?? cleanTitle}` : undefined}
  >
    <div class="ac__media">
      <div class="ac__frame">
        <img
          class="ac__img"
          src={assetUrl(entry.path)}
          alt={cleanTitle}
          width={entry.width}
          height={entry.height}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
        />
        <span class="ac__badge label">{typeBadge}</span>
        <span class="ac__scan" aria-hidden="true"></span>
      </div>
      {
        playable && (
          <svg class="ac__spikes" viewBox="-66 -66 132 132" aria-hidden="true" data-spikes>
            <defs>
              <radialGradient id={gid} gradientUnits="userSpaceOnUse" cx="0" cy="0" r="66">
                {/* 封面边(50/66≈0.76)正红 → 刺尖(63/66≈0.95)黑红，"红里带黑" */}
                <stop offset="0.76" stop-color="#f40000" />
                <stop offset="0.86" stop-color="#9c0000" />
                <stop offset="0.96" stop-color="#2b0000" />
              </radialGradient>
            </defs>
            <g class="ac__spikes-g" fill={`url(#${gid})`}>
              <path data-spike-path d="" />
            </g>
          </svg>
        )
      }
    </div>
    <div class="ac__body">
      <h3 class="ac__title">{cleanTitle}</h3>
      {subtitle && <p class="ac__sub">{subtitle}</p>}
    </div>
  </Tag>
</article>

<style>
  .ac {
    min-width: 0;
  }

  .ac__link {
    position: relative; /* 刺环 SVG 的定位基准 */
    display: block;
    color: inherit;
  }

  /* 可播放的卡片渲染成 <button>，清掉浏览器默认样式 */
  button.ac__link {
    width: 100%;
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  /* 可播放的卡片：双击封面播放。触摸设备上要禁掉双击缩放，
     否则第二次点按会被浏览器当成缩放手势。 */
  button.ac__link {
    touch-action: manipulation;
    -webkit-user-select: none;
    user-select: none;
  }

  /* 正在播放的那张：描边亮起（reduced-motion 下这是唯一反馈） */
  .ac.is-playing .ac__frame {
    border-color: var(--gbc-red);
  }

  /* ---- 音频驱动的红刺环 ----
     player.ts 沿方框周界采样后重写 <path> 的 d。关键布局：SVG 铺到封面的
     132%（viewBox ±66 ⇒ 封面对应 ±50、刺尖最长 63），垫在封面(z-index:1)之下 ——
     静止时路径正好是封面方框、完全藏在封面后面，声音越强刺沿方框边缘
     向外长，只在封面四周的窄环里出现，不侵入画面也不压到曲名 */
  /* 封面 + 刺环的定位容器：高度正好等于封面（frame 是 1:1 且撑满宽度），
     这样刺环用百分比定位才是以「封面」为基准。
     注意不能直接相对 .ac__link 定位 —— 那里面还有标题，百分比高度会按
     含标题的高度算，SVG 被拉成长方形后 preserveAspectRatio 会把图形
     居中缩到短边，整个环会往下偏移十几像素 */
  .ac__media {
    position: relative;
  }

  .ac__spikes {
    position: absolute;
    left: -16%;
    top: -16%;
    width: 132%;
    height: 132%;
    /* 全局有 svg{max-width:100%}，不覆盖的话会被压回容器宽，
       刺永远藏在封面后面伸不出来 */
    max-width: none;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.5s var(--ease-out-cubic);
  }

  .ac.is-playing .ac__spikes {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .ac__spikes {
      display: none;
    }
  }

  .ac__frame {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--ink-850);
    border: 1px solid var(--border);
    transition: border-color var(--dur-base) var(--ease-out-cubic);
    /* 压在刺环 SVG 之上：静止时把刺全部挡住，动态时只露出
       越过盘沿的刺尖 */
    z-index: 1;
  }

  .ac__link:hover .ac__frame {
    border-color: var(--gbc-red);
  }

  .ac__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }

  .ac__link:hover .ac__img {
    transform: scale(1.04);
  }

  .ac__badge {
    position: absolute;
    top: var(--sp-2);
    left: var(--sp-2);
    padding: 3px var(--sp-2);
    background: rgba(14, 15, 19, 0.8);
    color: var(--ink-100);
    backdrop-filter: blur(4px);
    border-radius: var(--r-sm);
  }

  /* 底部红色扫描条：悬停自左向右展开 */
  .ac__scan {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--gbc-red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }

  .ac__link:hover .ac__scan {
    transform: scaleX(1);
  }

  .ac__body {
    padding-top: var(--sp-3);
  }

  .ac__title {
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    letter-spacing: 0.01em;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ac__sub {
    margin-top: var(--sp-1);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--ink-300);
  }

  @media (prefers-reduced-motion: reduce) {
    .ac__img,
    .ac__scan {
      transition: none;
    }

    .ac__link:hover .ac__img {
      transform: none;
    }
    .ac__link:hover .ac__scan {
      transform: scaleX(1);
    }
  }
</style>
