---
/**
 * 语言切换：中 / EN / 日
 *  - 客户端切换（见 src/scripts/i18n.ts），不刷新页面、不跳路由，
 *    所以正在播的歌和歌词面板状态都不会丢
 *  - 状态存在 localStorage["gbc.lang"]，<head> 里的内联脚本会在首屏绘制前
 *    把结果写到 <html data-lang>，避免整页闪一下中文
 */
import { LANGS, LANG_NAME, LANG_SHORT } from "../i18n";

interface Props {
  /** nav = 顶部条里的紧凑版；drawer = 抽屉里的大号版 */
  variant?: "nav" | "drawer";
  /** 允许调用方追加类名（Astro 不会自动透传 class） */
  class?: string;
}
const { variant = "nav", class: cls = "" } = Astro.props;
---

<div
  class:list={["lang", `lang--${variant}`, cls]}
  role="group"
  data-i18n-attr="aria-label:nav.lang.aria"
  aria-label="切换语言"
>
  {/* 当前语言的红底由这个滑块承担：切换时它滑过去，而不是按钮各自闪一下 */}
  <span class="lang__pill" aria-hidden="true"></span>
  {
    LANGS.map((l) => (
      <button
        class:list={["lang__btn", l === "zh" && "is-on"]}
        type="button"
        data-lang-set={l}
        title={LANG_NAME[l]}
        aria-pressed={l === "zh" ? "true" : "false"}
      >
        {LANG_SHORT[l]}
      </button>
    ))
  }
</div>

<style>
  .lang {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
  }

  .lang__pill {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-radius: 999px;
    background: var(--accent);
    pointer-events: none;
    opacity: 0;
  }

  /* 首帧先把滑块放到当前语言上，再打开过渡，
     否则刚加载时它会从左上角滑进来 */
  .lang.is-ready .lang__pill {
    opacity: 1;
    transition:
      transform 360ms var(--ease-out-expo),
      width 360ms var(--ease-out-expo),
      height 360ms var(--ease-out-expo);
  }

  .lang__btn {
    position: relative;
    z-index: 1;
    min-width: 34px;
    height: 26px;
    padding: 0 6px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-400);
    font-family: var(--font-lyric);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    cursor: pointer;
    /* 底色交给滑块，按钮只做文字颜色的过渡 */
    transition: color 260ms var(--ease-out-cubic);
  }

  .lang__btn:hover {
    color: var(--fg);
  }

  .lang__btn.is-on {
    color: #fff;
  }

  /* 320px 窄屏：顶部条要同时放品牌标、切换器、汉堡，按钮收小一点 */
  @media (max-width: 359.98px) {
    .lang {
      padding: 2px;
    }

    .lang__btn {
      min-width: 29px;
      height: 24px;
      padding: 0 4px;
      font-size: 11px;
    }
  }

  .lang--drawer .lang__btn {
    min-width: 52px;
    height: 34px;
    font-size: 14px;
  }
</style>
