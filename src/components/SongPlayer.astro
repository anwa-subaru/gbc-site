---
/**
 * 全曲播放器（音乐页）
 *  - 38 首收录曲（本地 mp3，逐首对应发行物封面）
 *  - 桌面：左「正在播放」面板(吸顶) + 右曲目表；移动：曲目表 + 底部吸附迷你条
 *  - 交互在 src/scripts/player.ts（单 <audio>、Media Session、键盘可操作）
 *  - 不自动播放：首屏只有用户点击后才发声
 */
import { assetUrl } from "../lib/assets";
import songsData from "../data/songs.json";

interface Song {
  n: number;
  file: string;
  title: string;
  artist: string;
  dur: number;
  cover: string | null;
  album: string;
}

const songs = songsData as Song[];
const totalMin = Math.round(songs.reduce((a, s) => a + s.dur, 0) / 60);

const mmss = (sec: number): string =>
  `${Math.floor(sec / 60)}:${String(Math.floor(sec % 60)).padStart(2, "0")}`;
---

<section class="pl section container" id="player" data-player aria-labelledby="pl-heading">
  <header class="pl__head">
    <h2 class="pl__en" id="pl-heading">PLAYER</h2>
    <p class="pl__ja">全曲再生</p>
    <p class="pl__count num">{songs.length} TRACKS · {totalMin} MIN</p>
  </header>

  <div class="pl__grid">
    {/* ---------- 曲目表 ---------- */}
    <div class="pl__listwrap">
      <div class="pl__listbar">
        <button class="pl__all" type="button" data-play-all>
          <svg viewBox="0 0 16 16" aria-hidden="true" width="12" height="12">
            <path d="M4 2.5v11l9-5.5z" fill="currentColor" />
          </svg>
          播放全部
        </button>
        <button class="pl__shuffle" type="button" data-shuffle aria-pressed="false">
          <svg viewBox="0 0 16 16" aria-hidden="true" width="13" height="13">
            <path
              d="M2 4h2.6l1.8 2.4M2 12h2.6l5-6.6H14M11.4 3l2 2.4-2 2.4M11.4 8.6l2 2.4-2 2.4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          随机
        </button>
      </div>

      <ol class="pl__list" data-list>
        {
          songs.map((s) => (
            <li class="pl__item" data-item={s.n}>
              <button
                class="pl__row"
                type="button"
                data-track={s.n}
                data-src={assetUrl(s.file)}
                data-cover={s.cover ? assetUrl(s.cover) : ""}
                aria-label={`播放 ${s.title} / ${s.artist}`}
              >
                <span class="pl__no num">{String(s.n).padStart(2, "0")}</span>
                <span class="pl__thumb">
                  {s.cover ? (
                    <img src={assetUrl(s.cover)} alt="" width="48" height="48" loading="lazy" decoding="async" />
                  ) : (
                    <span class="pl__thumb--none" aria-hidden="true" />
                  )}
                  <span class="pl__hover" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="14" height="14">
                      <path d="M4 2.5v11l9-5.5z" fill="currentColor" />
                    </svg>
                  </span>
                </span>
                <span class="pl__meta">
                  <span class="pl__t">{s.title}</span>
                  <span class="pl__a">{s.artist}</span>
                </span>
                <span class="pl__eq num" aria-hidden="true">
                  <i /><i /><i />
                </span>
                <span class="pl__dur num">{mmss(s.dur)}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>

    {/* ---------- 正在播放（移动端为底部吸附条） ---------- */}
    <div class="pl__now" data-now>
      <span class="pl__seekline" aria-hidden="true"><i data-seekline /></span>

      <div class="pl__art">
        {
          songs[0].cover ? (
            <img src={assetUrl(songs[0].cover)} alt="" width="300" height="300" data-art />
          ) : null
        }
        <span class="pl__art--none" data-art-none aria-hidden="true">SELECT<br />A TRACK</span>
      </div>

      <div class="pl__info">
        <p class="pl__nowtitle" data-title>未选择曲目</p>
        <p class="pl__nowartist" data-artist>点击任意曲目开始播放</p>
      </div>

      <div class="pl__seek">
        <input
          class="pl__range"
          type="range"
          min="0"
          max="1000"
          value="0"
          step="1"
          data-seek
          aria-label="播放进度"
        />
        <p class="pl__times num"><span data-cur>0:00</span><span data-total>0:00</span></p>
      </div>

      <div class="pl__ctrl">
        <button class="pl__ic" type="button" data-prev aria-label="上一首">
          <svg viewBox="0 0 20 20" aria-hidden="true" width="18" height="18">
            <path d="M15 4v12L7 10zM5 4h1.6v12H5z" fill="currentColor" />
          </svg>
        </button>
        <button class="pl__ic pl__ic--main" type="button" data-toggle aria-label="播放">
          <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" data-icon-play>
            <path d="M7 4.5v15l13-7.5z" fill="currentColor" />
          </svg>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" data-icon-pause class="is-off">
            <path d="M7 4.5h3.4v15H7zM13.6 4.5H17v15h-3.4z" fill="currentColor" />
          </svg>
        </button>
        <button class="pl__ic" type="button" data-next aria-label="下一首">
          <svg viewBox="0 0 20 20" aria-hidden="true" width="18" height="18">
            <path d="M5 4v12l8-6zM13.4 4H15v12h-1.6z" fill="currentColor" />
          </svg>
        </button>
      </div>

      <div class="pl__vol">
        <svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14">
          <path
            d="M2 6h2.4L7.5 3.4v9.2L4.4 10H2zM10 5.4a3.4 3.4 0 010 5.2"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <input
          class="pl__range pl__range--vol"
          type="range"
          min="0"
          max="100"
          value="90"
          step="1"
          data-vol
          aria-label="音量"
        />
      </div>

      <audio data-audio preload="none"></audio>
    </div>
  </div>
</section>

<style>
  .pl {
    /* 触控目标下限兜底：曲目行整行可点，高度 ≥56px */
    --pl-row: 56px;
  }

  .pl__head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    flex-wrap: wrap;
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--sp-5);
  }

  .pl__en {
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    font-size: var(--fs-h2);
    line-height: 1;
    letter-spacing: 0.02em;
    margin: 0;
  }

  .pl__ja {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
    margin: 0;
  }

  .pl__count {
    margin: 0 0 0 auto;
    font-size: var(--fs-xs);
    color: var(--ink-400);
    letter-spacing: 0.06em;
  }

  .pl__grid {
    display: block;
  }

  /* ---------- 列表 ---------- */
  .pl__listbar {
    display: flex;
    gap: var(--sp-2);
    margin-bottom: var(--sp-3);
  }

  .pl__all,
  .pl__shuffle {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 40px;
    padding: 0 var(--sp-4);
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-raised);
    color: var(--fg);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out-cubic),
      background-color var(--dur-fast) var(--ease-out-cubic);
  }

  .pl__all {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink-000);
  }

  .pl__shuffle[aria-pressed="true"] {
    border-color: var(--neon-cyan);
    color: var(--neon-cyan);
  }

  .pl__all:hover,
  .pl__shuffle:hover {
    opacity: var(--opacity-hover);
  }

  .pl__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .pl__item {
    border-bottom: 1px solid var(--border);
  }

  .pl__row {
    display: grid;
    grid-template-columns: 2.2em 48px minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--sp-3);
    width: 100%;
    min-height: 64px;
    padding: var(--sp-2) var(--sp-2);
    background: none;
    border: 0;
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out-cubic);
  }

  .pl__row:hover {
    background: color-mix(in srgb, var(--ink-700) 45%, transparent);
  }

  .pl__no {
    font-size: var(--fs-xs);
    color: var(--ink-400);
    letter-spacing: 0.04em;
  }

  .pl__thumb {
    position: relative;
    display: block;
    width: 48px;
    height: 48px;
    overflow: hidden;
    background: var(--ink-800);
    border: 1px solid var(--border);
  }

  .pl__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pl__thumb--none {
    display: block;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      45deg,
      var(--ink-800),
      var(--ink-800) 5px,
      var(--ink-850) 5px,
      var(--ink-850) 10px
    );
  }

  .pl__hover {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(0 0 0 / 0.55);
    color: var(--ink-000);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out-cubic);
  }

  .pl__row:hover .pl__hover,
  .pl__row:focus-visible .pl__hover {
    opacity: 1;
  }

  .pl__meta {
    min-width: 0;
  }

  .pl__t {
    display: block;
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    line-height: 1.35;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  .pl__a {
    display: block;
    margin-top: 2px;
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }

  .pl__dur {
    font-size: var(--fs-xs);
    color: var(--ink-400);
  }

  /* 播放中的均衡器指示 */
  .pl__eq {
    display: none;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }

  .pl__eq i {
    display: block;
    width: 2px;
    height: 100%;
    background: var(--accent);
    transform-origin: bottom;
    animation: pl-eq 900ms var(--ease-out-cubic) infinite alternate;
  }

  .pl__eq i:nth-child(2) {
    animation-delay: 180ms;
  }

  .pl__eq i:nth-child(3) {
    animation-delay: 360ms;
  }

  @keyframes pl-eq {
    from {
      transform: scaleY(0.25);
    }
    to {
      transform: scaleY(1);
    }
  }

  .pl__item.is-playing .pl__eq {
    display: inline-flex;
  }

  .pl__item.is-playing .pl__t {
    color: var(--accent);
  }

  .pl__item.is-playing .pl__no {
    color: var(--accent);
  }

  .pl__item.is-paused .pl__eq i {
    animation-play-state: paused;
  }

  /* ---------- 正在播放 ---------- */
  .pl__now {
    position: sticky;
    bottom: 0;
    z-index: 5;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    grid-template-areas:
      "art info ctrl"
      "seek seek seek";
    align-items: center;
    gap: var(--sp-1) var(--sp-3);
    margin-top: var(--sp-4);
    padding: var(--sp-1) var(--sp-2) var(--sp-2);
    background: color-mix(in srgb, var(--ink-850) 96%, transparent);
    border: 1px solid var(--border);
    border-radius: 2px;
    backdrop-filter: blur(12px);
    box-shadow: 0 -12px 32px rgb(0 0 0 / 0.5);
  }

  .pl__seekline {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 2px;
    overflow: hidden;
    background: var(--ink-700);
  }

  .pl__seekline i {
    display: block;
    width: 0;
    height: 100%;
    background: var(--accent);
  }

  .pl__art {
    grid-area: art;
    position: relative;
    width: 40px;
    height: 40px;
    overflow: hidden;
    background: var(--ink-800);
    border: 1px solid var(--border);
  }

  .pl__art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pl__art--none {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-mono-num);
    font-size: 0.5rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-align: center;
    color: var(--ink-400);
    background: repeating-linear-gradient(
      45deg,
      var(--ink-800),
      var(--ink-800) 5px,
      var(--ink-850) 5px,
      var(--ink-850) 10px
    );
  }

  /* 占位图与封面互斥：本类的 display 会盖掉 UA 的 [hidden]，必须显式兜住 */
  .pl__art--none[hidden],
  .pl__art img[hidden] {
    display: none !important;
  }

  .pl__info {
    grid-area: info;
    min-width: 0;
  }

  .pl__nowtitle {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pl__nowartist {
    margin: 2px 0 0;
    font-size: var(--fs-xs);
    color: var(--fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pl__seek {
    grid-area: seek;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: -2px;
  }

  .pl__times {
    display: flex;
    gap: var(--sp-2);
    margin: 0;
    font-size: 0.625rem;
    letter-spacing: 0.02em;
    color: var(--ink-400);
    flex: 0 0 auto;
  }

  .pl__range {
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    height: 16px;
    margin: 0;
    appearance: none;
    background: none;
    cursor: pointer;
  }

  .pl__range::-webkit-slider-runnable-track {
    height: 2px;
    background: linear-gradient(
      to right,
      var(--accent) 0%,
      var(--accent) var(--p, 0%),
      var(--ink-700) var(--p, 0%),
      var(--ink-700) 100%
    );
  }

  .pl__range::-moz-range-track {
    height: 2px;
    background: linear-gradient(
      to right,
      var(--accent) 0%,
      var(--accent) var(--p, 0%),
      var(--ink-700) var(--p, 0%),
      var(--ink-700) 100%
    );
  }

  .pl__range::-webkit-slider-thumb {
    appearance: none;
    width: 10px;
    height: 10px;
    margin-top: -4px;
    border-radius: 50%;
    background: var(--ink-000);
    border: 0;
  }

  .pl__range::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border: 0;
    border-radius: 50%;
    background: var(--ink-000);
  }

  .pl__ctrl {
    grid-area: ctrl;
    display: flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .pl__ic {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--fg);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out-cubic),
      background-color var(--dur-fast) var(--ease-out-cubic);
  }

  .pl__ic:hover {
    color: var(--accent);
  }

  .pl__ic--main {
    width: 40px;
    height: 40px;
    background: var(--accent);
    color: var(--ink-000);
  }

  .pl__ic--main:hover {
    color: var(--ink-000);
    opacity: var(--opacity-hover);
  }

  .pl__ic[disabled] {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* 播放/暂停图标切换：SVG 元素既无 hidden 属性也不吃 UA 的 [hidden]，用 class */
  .pl__ic svg.is-off {
    display: none !important;
  }

  .pl__vol {
    display: none;
  }

  @media (min-width: 1024px) {
    .pl__grid {
      display: grid;
      grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
      gap: var(--sp-6);
      align-items: start;
    }

    .pl__listwrap {
      grid-column: 2;
      grid-row: 1;
    }

    .pl__now {
      grid-column: 1;
      grid-row: 1;
      position: sticky;
      /* 让开页头（sticky + 更高 z-index），否则面板顶部被压住 */
      top: calc(var(--nav-h) + var(--sp-3));
      bottom: auto;
      display: block;
      margin-top: 0;
      padding: var(--sp-4);
      background: var(--bg-raised);
      box-shadow: none;
      backdrop-filter: none;
    }

    .pl__seekline {
      display: none;
    }

    .pl__art {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      margin-bottom: var(--sp-4);
    }

    .pl__art--none {
      font-size: var(--fs-xs);
    }

    .pl__nowtitle {
      font-size: var(--fs-body-lg);
      white-space: normal;
    }

    .pl__nowartist {
      margin-top: var(--sp-1);
    }

    .pl__seek {
      margin-top: var(--sp-4);
      flex-wrap: wrap;
    }

    .pl__times {
      width: 100%;
      justify-content: space-between;
      order: 2;
    }

    .pl__ctrl {
      justify-content: center;
      gap: var(--sp-2);
      margin-top: var(--sp-3);
    }

    .pl__ic--main {
      width: 52px;
      height: 52px;
    }

    .pl__vol {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
      margin-top: var(--sp-4);
      padding-top: var(--sp-4);
      border-top: 1px solid var(--border);
      color: var(--fg-muted);
    }

    .pl__range--vol {
      flex: 1 1 auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pl__eq i {
      animation: none;
    }
  }
</style>
