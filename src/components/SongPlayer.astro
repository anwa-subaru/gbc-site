---
/**
 * 全曲播放器（音乐页）
 *  - 38 首收录曲（本地 mp3，逐首对应发行物封面）
 *  - 桌面：左「正在播放」面板(吸顶) + 右曲目表；移动：曲目表 + 底部吸附迷你条
 *  - 交互在 src/scripts/player.ts（单 <audio>、Media Session、键盘可操作）
 *  - 不自动播放：首屏只有用户点击后才发声
 */
import { assetUrl } from "../lib/assets";
import songsData from "../data/songs.json";

interface Song {
  n: number;
  file: string;
  title: string;
  artist: string;
  dur: number;
  cover: string | null;
  album: string;
}

const songs = songsData as Song[];
const totalMin = Math.round(songs.reduce((a, s) => a + s.dur, 0) / 60);

const mmss = (sec: number): string =>
  `${Math.floor(sec / 60)}:${String(Math.floor(sec % 60)).padStart(2, "0")}`;
---

<section class="pl section container" id="player" data-pl-list aria-labelledby="pl-heading">
  <header class="pl__head">
    <h2 class="pl__en" id="pl-heading">PLAYER</h2>
    <p class="pl__ja" data-i18n="songplayer.subtitle">全曲再生</p>
    <p class="pl__count num">{songs.length} TRACKS · {totalMin} MIN</p>
  </header>

  <div class="pl__grid">
    {/* ---------- 曲目表 ---------- */}
    <div class="pl__listwrap">
      <div class="pl__listbar">
        <button class="pl__all" type="button" data-play-all>
          <svg viewBox="0 0 16 16" aria-hidden="true" width="12" height="12">
            <path d="M4 2.5v11l9-5.5z" fill="currentColor" />
          </svg>
          <span data-i18n="songplayer.playall">播放全部</span>
        </button>
        <button
          class="pl__mode"
          type="button"
          data-playmode
          data-mode="list"
          aria-label="播放模式：列表循环（点击切换）"
          title="播放模式：列表循环（点击切换）"
        >
          <!-- 列表循环 -->
          <svg data-mode-icon="list" viewBox="0 0 16 16" aria-hidden="true" width="15" height="15">
            <path
              d="M3 6.5A3.5 3.5 0 016.5 3h5M11 1.5L13 3l-2 1.5M13 9.5A3.5 3.5 0 019.5 13h-5M5 14.5L3 13l2-1.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <!-- 单曲循环：同一个环，中间加一个 1 -->
          <svg
            data-mode-icon="one"
            class="is-off"
            viewBox="0 0 16 16"
            aria-hidden="true"
            width="15"
            height="15"
          >
            <path
              d="M3 6.5A3.5 3.5 0 016.5 3h5M11 1.5L13 3l-2 1.5M13 9.5A3.5 3.5 0 019.5 13h-5M5 14.5L3 13l2-1.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M7.2 6.4l1.6-1.1v5.4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <!-- 随机播放：交叉箭头 -->
          <svg
            data-mode-icon="shuffle"
            class="is-off"
            viewBox="0 0 16 16"
            aria-hidden="true"
            width="15"
            height="15"
          >
            <path
              d="M2 4h2.6l1.8 2.4M2 12h2.6l5-6.6H14M11.4 3l2 2.4-2 2.4M11.4 8.6l2 2.4-2 2.4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <!-- 顺序播放（不循环）：直箭头 -->
          <svg
            data-mode-icon="off"
            class="is-off"
            viewBox="0 0 16 16"
            aria-hidden="true"
            width="15"
            height="15"
          >
            <path
              d="M2.5 8h9M9 5.2L12 8l-3 2.8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span data-playmode-label>列表循环</span>
        </button>
      </div>

      <ol class="pl__list" data-list>
        {
          songs.map((s) => (
            <li class="pl__item" data-item={s.n}>
              <button
                class="pl__row"
                type="button"
                data-track={s.n}
                data-src={assetUrl(s.file)}
                data-cover={s.cover ? assetUrl(s.cover) : ""}
                aria-label={`播放 ${s.title} / ${s.artist}`}
                data-i18n-attr="aria-label:songplayer.row.aria"
                data-i18n-vars={`title:${s.title},artist:${s.artist}`}
              >
                <span class="pl__no num">{String(s.n).padStart(2, "0")}</span>
                <span class="pl__thumb">
                  {s.cover ? (
                    <img src={assetUrl(s.cover)} alt="" width="48" height="48" loading="lazy" decoding="async" />
                  ) : (
                    <span class="pl__thumb--none" aria-hidden="true" />
                  )}
                  <span class="pl__hover" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="14" height="14">
                      <path d="M4 2.5v11l9-5.5z" fill="currentColor" />
                    </svg>
                  </span>
                </span>
                <span class="pl__meta">
                  <span class="pl__t">{s.title}</span>
                  <span class="pl__a">{s.artist}</span>
                </span>
                <span class="pl__eq num" aria-hidden="true">
                  <i /><i /><i />
                </span>
                <span class="pl__dur num">{mmss(s.dur)}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>

</section>

<style>
  .pl {
    /* 触控目标下限兜底：曲目行整行可点，高度 ≥56px */
    --pl-row: 56px;
  }

  .pl__head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    flex-wrap: wrap;
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--sp-5);
  }

  .pl__en {
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    font-size: var(--fs-h2);
    line-height: 1;
    letter-spacing: 0.02em;
    margin: 0;
  }

  .pl__ja {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
    margin: 0;
  }

  .pl__count {
    margin: 0 0 0 auto;
    font-size: var(--fs-xs);
    color: var(--ink-400);
    letter-spacing: 0.06em;
  }

  .pl__grid {
    display: block;
  }

  /* ---------- 列表 ---------- */
  .pl__listbar {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--sp-2);
    margin-bottom: var(--sp-3);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .pl__listbar::-webkit-scrollbar {
    display: none;
  }

  .pl__all,
  .pl__mode {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding: 0 var(--sp-4);
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-raised);
    color: var(--fg);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out-cubic),
      background-color var(--dur-fast) var(--ease-out-cubic);
  }

  .pl__all {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink-000);
  }

  /* 播放模式按钮：随机已并进来，一个按钮轮换
     列表循环 → 单曲循环 → 随机播放 → 顺序播放。
     每种模式有自己的图标（单曲循环是环里带一个 1），
     颜色只是辅助，不再只靠颜色区分 */
  .pl__mode {
    margin-left: auto;
  }

  .pl__mode svg.is-off {
    display: none;
  }

  .pl__mode[data-mode="list"] {
    border-color: var(--neon-cyan);
    color: var(--neon-cyan);
  }

  .pl__mode[data-mode="one"] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .pl__mode[data-mode="shuffle"] {
    border-color: var(--neon-pink);
    color: var(--neon-pink);
  }

  .pl__mode[data-mode="off"] {
    color: var(--ink-400);
  }

  .pl__all:hover,
  .pl__mode:hover {
    opacity: var(--opacity-hover);
  }

  /* 小屏：三个胶囊按钮（播放全部 / 循环 / 随机）在 360~414px 下放不下，
     收窄内边距并降一档字号，一行刚好放下。
     必须放在上面所有按钮基础规则之后 —— 同优先级时靠后的才生效
     （之前放在前面，被基础规则的 padding/font-size 覆盖，等于没写）
     再窄就横向滚动，绝不折行 */
  @media (max-width: 639px) {
    .pl__listbar {
      gap: 6px;
    }

    .pl__all,
    .pl__mode {
      padding: 0 10px;
      font-size: var(--fs-xs);
      white-space: nowrap;
    }
  }

  .pl__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .pl__item {
    border-bottom: 1px solid var(--border);
  }

  .pl__row {
    display: grid;
    grid-template-columns: 2.2em 48px minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--sp-3);
    width: 100%;
    min-height: 64px;
    padding: var(--sp-2) var(--sp-2);
    background: none;
    border: 0;
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out-cubic);
  }

  .pl__row:hover {
    background: color-mix(in srgb, var(--ink-700) 45%, transparent);
  }

  .pl__no {
    font-size: var(--fs-xs);
    color: var(--ink-400);
    letter-spacing: 0.04em;
  }

  .pl__thumb {
    position: relative;
    display: block;
    width: 48px;
    height: 48px;
    overflow: hidden;
    background: var(--ink-800);
    border: 1px solid var(--border);
  }

  .pl__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pl__thumb--none {
    display: block;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      45deg,
      var(--ink-800),
      var(--ink-800) 5px,
      var(--ink-850) 5px,
      var(--ink-850) 10px
    );
  }

  .pl__hover {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(0 0 0 / 0.55);
    color: var(--ink-000);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out-cubic);
  }

  .pl__row:hover .pl__hover,
  .pl__row:focus-visible .pl__hover {
    opacity: 1;
  }

  .pl__meta {
    min-width: 0;
  }

  .pl__t {
    display: block;
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    line-height: 1.35;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  .pl__a {
    display: block;
    margin-top: 2px;
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }

  .pl__dur {
    font-size: var(--fs-xs);
    color: var(--ink-400);
  }

  /* 播放中的均衡器指示 */
  .pl__eq {
    display: none;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }

  .pl__eq i {
    display: block;
    width: 2px;
    height: 100%;
    background: var(--accent);
    transform-origin: bottom;
    animation: pl-eq 900ms var(--ease-out-cubic) infinite alternate;
  }

  .pl__eq i:nth-child(2) {
    animation-delay: 180ms;
  }

  .pl__eq i:nth-child(3) {
    animation-delay: 360ms;
  }

  @keyframes pl-eq {
    from {
      transform: scaleY(0.25);
    }
    to {
      transform: scaleY(1);
    }
  }

  .pl__item.is-playing .pl__eq {
    display: inline-flex;
  }

  .pl__item.is-playing .pl__t {
    color: var(--accent);
  }

  .pl__item.is-playing .pl__no {
    color: var(--accent);
  }

  .pl__item.is-paused .pl__eq i {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .pl__eq i {
      animation: none;
    }
  }
</style>
